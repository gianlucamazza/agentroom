      type: external_exports.literal("INVITE_CLAIM"),
      invite_id: external_exports.uuid(),
      from: b64,
      ciphertext: b64Cipher,
      nonce: b64,
      sig: b64
    });
    RoutedSchema = base.extend({
      type: external_exports.enum(["MSG", "SESSION_INIT", "SESSION_ACK"]),
      from: b64,
      to: b64,
      ciphertext: b64Cipher,
      nonce: b64,
      sig: b64,
      seq: external_exports.number().int().nonnegative(),
      ratchet_pk: b64.optional()
    });
    AckSchema = base.extend({
      type: external_exports.literal("ACK"),
      ref_msg_id: external_exports.uuid(),
      status: external_exports.enum(["delivered", "queued", "error"]),
      error: external_exports.string().max(1024).optional()
    });
    DeliverySchema = base.extend({
      type: external_exports.literal("DELIVERY"),
      routed: RoutedSchema
    });
    PingSchema = base.extend({ type: external_exports.literal("PING") });
    PongSchema = base.extend({ type: external_exports.literal("PONG") });
    ErrorSchema = base.extend({
      type: external_exports.literal("ERROR"),
      code: external_exports.string().max(64),
      message: external_exports.string().max(1024)
    });
    AnyFrameSchema = external_exports.discriminatedUnion("type", [
      HelloSchema,
      HelloAckSchema,
      InvitePublishSchema,
      InviteClaimSchema,
      RoutedSchema,
      AckSchema,
      DeliverySchema,
      PingSchema,
      PongSchema,
      ErrorSchema
    ]);
  }
});

// packages/server/dist/chunk-IRL77W62.js
import { createServer } from "http";
import { readFileSync as readFileSync6, existsSync as existsSync8 } from "fs";
import { randomUUID as randomUUID3 } from "crypto";
import { DatabaseSync } from "node:sqlite";
import path6 from "path";
import fs from "fs";
import { createHmac, randomBytes as randomBytes3, timingSafeEqual } from "crypto";
function runAuthMaintenance(now = Date.now()) {
  const challengeCutoff = now - CHALLENGE_TTL_MS;
  for (const [k, v] of challenges) {
    if (v < challengeCutoff) challenges.delete(k);
  }
  for (const [k, b] of rateBuckets) {
    if (now - b.lastRefill > BUCKET_IDLE_TTL_MS) rateBuckets.delete(k);
  }
}
function clearChallengeInterval() {
  clearInterval(challengeCleanupTimer);
}
function consumeRate(key, capacity, refillPerSec) {
  if (process.env["RATE_LIMIT_DISABLED"] === "1") return true;
  const now = Date.now();
  let bucket = rateBuckets.get(key);
  if (!bucket) {
    bucket = { tokens: capacity, lastRefill: now };
    rateBuckets.set(key, bucket);
  } else {
    const elapsed = (now - bucket.lastRefill) / 1e3;
    bucket.tokens = Math.min(capacity, bucket.tokens + elapsed * refillPerSec);
    bucket.lastRefill = now;
  }
  if (bucket.tokens < 1) return false;
  bucket.tokens -= 1;
  return true;
}
function consumeChallengeRate(ip) {
  return consumeRate(`challenge:${ip}`, 10, 10 / 60);
}
function consumeHelloFailRate(ip) {
  return consumeRate(`hello_fail:${ip}`, 5, 5 / 60);
}
function consumeFrameRate(pk) {
  return consumeRate(`frames:${pk}`, 120, 1);
}
function secret() {
  const s = process.env["HMAC_SECRET"];
  if (!s || s.length < 32) {
    throw new Error(
      `HMAC_SECRET env var is missing or too short (min 32 chars). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
    );
  }
  return s;
}
function previousSecret() {
  const s = process.env["HMAC_SECRET_PREVIOUS"];
  return s && s.length >= 32 ? s : null;
}
function issueChallenge() {
  const token = randomBytes3(24).toString("base64url");
  challenges.set(token, Date.now());
  return token;
}
function consumeChallenge(token) {
  const ts = challenges.get(token);
  if (!ts) return false;
  challenges.delete(token);
  return Date.now() - ts < CHALLENGE_TTL_MS;
}
function issueSessionToken(ed25519_pk) {
  const jti = randomBytes3(8).toString("base64url");
  const payload = `${jti}.${ed25519_pk}.${Date.now()}`;
  const mac3 = createHmac("sha256", secret()).update(payload).digest("base64url");
  return `${Buffer.from(payload).toString("base64url")}.${mac3}`;
}
function verifySessionToken(token, maxAgeMs = 36e5) {
  try {
    const dotIdx = token.indexOf(".");
    if (dotIdx < 0) return { valid: false };
    const payloadB64 = token.slice(0, dotIdx);
    const mac3 = token.slice(dotIdx + 1);
    if (!payloadB64 || !mac3) return { valid: false };
    const payload = Buffer.from(payloadB64, "base64url").toString();
    const macBuf = Buffer.from(mac3);
    const matched = [secret(), previousSecret()].filter((s) => s !== null).map(
      (s) => Buffer.from(
        createHmac("sha256", s).update(payload).digest("base64url")
      )
    ).some(
      (expected) => macBuf.length === expected.length && timingSafeEqual(macBuf, expected)
    );
    if (!matched) return { valid: false };
    const parts = payload.split(".");
    if (parts.length < 3) return { valid: false };
    const jti = parts[0];
    const tsStr = parts[parts.length - 1];
    const pk = parts.slice(1, -1).join(".");
    if (!pk || !tsStr) return { valid: false };
    if (Date.now() - parseInt(tsStr, 10) > maxAgeMs) return { valid: false };
    return { valid: true, pk, jti };
  } catch {
    return { valid: false };
  }
}
function inc(name, by = 1) {
  counters.set(name, (counters.get(name) ?? 0) + by);
}
function set2(name, val) {
  counters.set(name, val);
}
function snapshot() {
  return Object.fromEntries(counters);
}
function configuredLevel() {
  const env = (process.env["LOG_LEVEL"] ?? "info").toLowerCase();
  return env in LEVELS ? env : "info";
}
function logEvent(level, event, fields) {
  if (LEVELS[level] > LEVELS[configuredLevel()]) return;
  console.log(JSON.stringify({ ts: Date.now(), level, event, ...fields }));
}
function getPk(ws) {
  return wsPkMap.get(ws);
}
function setPk(ws, pk) {
  wsPkMap.set(ws, pk);
}
function clearWssIntervals() {
  for (const t of pingIntervals) clearInterval(t);
  pingIntervals.clear();
  if (pruneTimer) {
    clearInterval(pruneTimer);
    pruneTimer = null;
  }
}
function getWss() {
  return _wss;
}
function send(ws, data) {
  if (ws.readyState === import_websocket.default.OPEN) {
    ws.send(JSON.stringify(data));
  }
}
function canDeliverNow(ws) {
  return ws.readyState === import_websocket.default.OPEN && ws.bufferedAmount <= BACKPRESSURE_BYTES;
}
function errorFrame(code, message) {
  return {
    v: PROTOCOL_VERSION,
    type: "ERROR",
    msg_id: randomUUID3(),
    ts: Date.now(),
    code,
    message
  };
}
function ackFrame(ref_msg_id, status, error51) {
  return {
    v: PROTOCOL_VERSION,
    type: "ACK",
    msg_id: randomUUID3(),
    ts: Date.now(),
    ref_msg_id,
    status,
    ...error51 !== void 0 ? { error: error51 } : {}
  };
}
function flushPending(ws, pk) {
  const pending = store.dequeuePending(pk);
  for (const { id, envelope } of pending) {
    let routed;
    try {
      routed = JSON.parse(envelope);
    } catch {
      logEvent("warn", "pending.dropped_malformed", { id });
      store.deletePending(id);
      continue;
    }
    if (!canDeliverNow(ws)) break;
    send(ws, {
      v: PROTOCOL_VERSION,
      type: "DELIVERY",
      msg_id: randomUUID3(),
      ts: Date.now(),
      routed
    });
    store.deletePending(id);
  }
}
async function handleHello(ws, frame, remoteIp) {
  if (!consumeChallenge(frame.challenge)) {
    send(ws, errorFrame("INVALID_CHALLENGE", "challenge expired or unknown"));
    ws.close();
    return;
  }
  const msgBytes = new TextEncoder().encode(frame.challenge);
  const valid = await verify(
    msgBytes,
    fromBase64(frame.sig),
    fromBase64(frame.ed25519_pk)
  );
  if (!valid) {
    inc("hello_failures");
    logEvent("warn", "hello.fail", {
      ip: remoteIp,
      pk: frame.ed25519_pk.slice(0, 8)
    });
    if (!consumeHelloFailRate(remoteIp)) {
      inc("rate_limit_hits");
      send(ws, errorFrame("RATE_LIMIT", "too many authentication failures"));
      ws.close(1008, "RATE_LIMIT");
      return;
    }
    send(ws, errorFrame("INVALID_SIG", "signature verification failed"));
    ws.close();
    return;
  }
  store.upsertAgent(frame.ed25519_pk, frame.x25519_pk);
  const session_token = issueSessionToken(frame.ed25519_pk);
  send(ws, {
    v: PROTOCOL_VERSION,
    type: "HELLO_ACK",
    msg_id: randomUUID3(),
    ts: Date.now(),
    session_token
  });
  const existing = agents.get(frame.ed25519_pk);
  if (existing && existing.ws !== ws && existing.ws.readyState === import_websocket.default.OPEN) {
    existing.ws.close(1e3, "replaced by new connection");
  }
  setPk(ws, frame.ed25519_pk);
  agents.set(frame.ed25519_pk, { ws, pk: frame.ed25519_pk });
  set2("ws_connections", agents.size);
  logEvent("info", "hello.success", { pk: frame.ed25519_pk.slice(0, 8) });
  flushPending(ws, frame.ed25519_pk);
}
function handleInvitePublish(ws, frame) {
  const pk = getPk(ws);
  if (!pk) {
    send(ws, errorFrame("UNAUTH", "not authenticated"));
    return;
  }
  const maxInvites = parseInt(process.env["MAX_INVITES_PER_PK"] ?? "20", 10);
  if (store.countOpenInvitesByPk(pk) >= maxInvites) {
    send(ws, errorFrame("INVITE_QUOTA", "too many unclaimed invites"));
    return;
  }
  const maxExpiresAt = Date.now() + 7 * 24 * 36e5;
  store.publishInvite(
    frame.invite_id,
    frame.blob,
    pk,
    Math.min(frame.expires_at, maxExpiresAt)
  );
  send(ws, ackFrame(frame.msg_id, "delivered"));
}
async function handleInviteClaim(ws, frame) {
  const invite = store.getInvite(frame.invite_id);
  if (!invite) {
    send(ws, errorFrame("NOT_FOUND", "invite not found"));
    return;
  }
  if (invite.claimed_at) {
    send(ws, errorFrame("ALREADY_CLAIMED", "invite already used"));
    return;
  }
  if (invite.expires_at <= Date.now()) {
    send(ws, errorFrame("EXPIRED", "invite expired"));
    return;
  }
  const sigPayload = new TextEncoder().encode(
    JSON.stringify({
      from: frame.from,
      to: invite.inviter_pk,
      seq: 0,
      nonce: frame.nonce
    })
  );
  const claimSigValid = await verify(
    sigPayload,
    fromBase64(frame.sig),
    fromBase64(frame.from)
  );
  if (!claimSigValid) {
    logEvent("warn", "invite_claim.invalid_sig", {
      from: frame.from.slice(0, 8),
      invite_id: frame.invite_id
    });
    send(
      ws,
      errorFrame("INVALID_SIG", "INVITE_CLAIM signature verification failed")
    );
    return;
  }
  const maxMsgs = parseInt(process.env["MAX_PENDING_MSGS"] ?? "500", 10);
  const inviter = agents.get(invite.inviter_pk);
  const deliverNow = inviter !== void 0 && canDeliverNow(inviter.ws);
  if (!deliverNow && store.countPending(invite.inviter_pk) >= maxMsgs) {
    send(ws, ackFrame(frame.msg_id, "error", "recipient queue full"));
    return;
  }
  const ok = store.claimInvite(frame.invite_id);
  if (!ok) {
    send(ws, errorFrame("ALREADY_CLAIMED", "invite already used"));
    return;
  }
  const initFrame = {
    v: PROTOCOL_VERSION,
    type: "SESSION_INIT",
    msg_id: frame.msg_id,
    ts: frame.ts,
    from: frame.from,
    to: invite.inviter_pk,
    ciphertext: frame.ciphertext,
    nonce: frame.nonce,
    sig: frame.sig,
    seq: 0
  };
  if (deliverNow && inviter) {
    send(inviter.ws, {
      v: PROTOCOL_VERSION,
      type: "DELIVERY",
      msg_id: randomUUID3(),
      ts: Date.now(),
      routed: initFrame
    });
  } else {
    store.enqueuePending(
      randomUUID3(),
      invite.inviter_pk,
      JSON.stringify(initFrame)
    );
  }
  send(ws, ackFrame(frame.msg_id, "queued"));
}
function handleRouted(ws, frame) {
  const pk = getPk(ws);
  if (!pk || pk !== frame.from) {
    send(ws, errorFrame("UNAUTH", "from mismatch"));
    return;
  }
  const maxMsgs = parseInt(process.env["MAX_PENDING_MSGS"] ?? "500", 10);
  const recipient = agents.get(frame.to);
  if (recipient && canDeliverNow(recipient.ws)) {
    send(recipient.ws, {
      v: PROTOCOL_VERSION,
      type: "DELIVERY",
      msg_id: randomUUID3(),
      ts: Date.now(),
      routed: frame
    });
    send(ws, ackFrame(frame.msg_id, "delivered"));
    inc("messages_routed_total");
  } else {
    if (store.countPending(frame.to) >= maxMsgs) {
      send(ws, ackFrame(frame.msg_id, "error", "recipient queue full"));
      return;
    }
    store.enqueuePending(randomUUID3(), frame.to, JSON.stringify(frame));
    send(ws, ackFrame(frame.msg_id, "queued"));
    inc("messages_routed_total");
  }
}
function handleConnection(ws, req) {
  const remoteIp = req.socket?.remoteAddress ?? "unknown";
  const url2 = new URL(req.url ?? "/", "http://localhost");
  const authHeader = req.headers["authorization"];
  const headerToken = typeof authHeader === "string" && authHeader.startsWith("Bearer ") ? authHeader.slice("Bearer ".length) : null;
  const token = headerToken ?? url2.searchParams.get("token");
  if (token) {
    const result = verifySessionToken(token);
    if (result.valid) {
      setPk(ws, result.pk);
      agents.set(result.pk, { ws, pk: result.pk });
      store.touchAgent(result.pk);
      set2("ws_connections", agents.size);
      flushPending(ws, result.pk);
    } else {
      send(ws, errorFrame("UNAUTH", "invalid or expired session token"));
    }
  }
  const pingInterval = setInterval(() => {
    if (ws.readyState === import_websocket.default.OPEN) ws.ping();
  }, 3e4);
  pingIntervals.add(pingInterval);
  ws.on("pong", () => {
  });
  ws.on("ping", () => ws.pong());
  ws.on("message", async (raw) => {
    let parsed;
    try {
      parsed = JSON.parse(raw.toString());
    } catch {
      send(ws, errorFrame("BAD_JSON", "invalid JSON"));
      return;
    }
    const result = parseFrame(parsed);
    if (!result.ok) {
      send(ws, errorFrame("BAD_FRAME", result.error));
      return;
    }
    const frame = result.data;
    const authedPk = getPk(ws);
    if (authedPk && !consumeFrameRate(authedPk)) {
      inc("rate_limit_hits");
      send(ws, errorFrame("RATE_LIMIT", "too many frames"));
      return;
    }
    if (frame.type === "PING") {
      send(ws, { ...frame, type: "PONG" });
      return;
    }
    if (frame.type === "PONG") return;
    if (frame.type === "HELLO") {
      await handleHello(ws, frame, remoteIp);
      return;
    }
    if (!authedPk) {
      send(ws, errorFrame("UNAUTH", "authenticate first with HELLO"));
      return;
    }
    switch (frame.type) {
      case "INVITE_PUBLISH":
        handleInvitePublish(ws, frame);
        break;
      case "INVITE_CLAIM":
        await handleInviteClaim(ws, frame);
        break;
      case "MSG":
      case "SESSION_INIT":
      case "SESSION_ACK":
        handleRouted(ws, frame);
        break;
      default:
        send(ws, errorFrame("UNKNOWN_TYPE", "unexpected frame type"));
    }
  });
  ws.on("close", () => {
    pingIntervals.delete(pingInterval);
    clearInterval(pingInterval);
    const pk = getPk(ws);
    if (pk && agents.get(pk)?.ws === ws) {
      agents.delete(pk);
      set2("ws_connections", agents.size);
    }
  });
  ws.on("error", () => ws.close());
}
function attachWss(httpServer) {
  const maxPayload = parseInt(
    process.env["WS_MAX_PAYLOAD"] ?? String(256 * 1024),
    10
  );
  const wss = new import_websocket_server.default({ noServer: true, maxPayload });
  _wss = wss;
  httpServer.on("upgrade", (req, socket, head) => {
    const { pathname } = new URL(req.url ?? "/", "http://localhost");
    if (pathname !== "/ws") {
      socket.destroy();
      return;
    }
    const maxConns = parseInt(process.env["MAX_CONNECTIONS"] ?? "500", 10);
    if (wss.clients.size >= maxConns) {
      logEvent("warn", "upgrade.refused", { reason: "max_connections" });
      socket.write(
        "HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\n\r\n"
      );
      socket.destroy();
      return;
    }
    wss.handleUpgrade(req, socket, head, (ws) => {
      wss.emit("connection", ws, req);
    });
  });
  wss.on("connection", handleConnection);
  pruneTimer = setInterval(() => {
    store.prune(parseInt(process.env["PENDING_TTL_DAYS"] ?? "7", 10));
  }, 36e5);
  pruneTimer.unref?.();
  return wss;
}
function getIp(req) {
  if (TRUST_PROXY) {
    const fwd = req.headers["x-forwarded-for"];
    const first = Array.isArray(fwd) ? fwd[0] : fwd?.split(",")[0];
    if (first) return first.trim();
  }
  return req.socket?.remoteAddress ?? "unknown";
}
function json2(res, status, body) {
  const data = JSON.stringify(body);
  res.writeHead(status, { "Content-Type": "application/json" });
  res.end(data);
}
function handleRequest(req, res) {
  const url2 = new URL(req.url ?? "/", "http://localhost");
  if (req.method === "GET" && url2.pathname === "/auth/challenge") {
    const ip = getIp(req);
    if (!consumeChallengeRate(ip)) {
      inc("rate_limit_hits");
      return json2(res, 429, { error: "too many requests" });
    }
    inc("challenges_issued");
    const challenge = issueChallenge();
    return json2(res, 200, { challenge });
  }
  if (req.method === "GET" && url2.pathname === "/health") {
    let dbStatus = "ok";
    let agentsN = 0;
    try {
      agentsN = store.countAgents();
    } catch {
      dbStatus = "error";
    }
    return json2(res, 200, {
      ok: dbStatus === "ok",
      db: dbStatus,
      agents: agentsN,
      pending: store.countAllPending(),
      invites: store.countInvites(),
      uptime_s: Math.floor((Date.now() - startedAt) / 1e3)
    });
  }
  if (req.method === "GET" && url2.pathname === "/metrics") {
    return json2(res, 200, snapshot());
  }
  json2(res, 404, { error: "not found" });
}
async function startServer() {
  process.removeAllListeners("warning");
  for (const envPath of [".env", "../../.env", "../../../.env"].map(
    (p) => new URL(p, import.meta.url).pathname
  )) {
    if (existsSync8(envPath)) {
      for (const line of readFileSync6(envPath, "utf8").split("\n")) {
        const t = line.trim();
        if (!t || t.startsWith("#")) continue;
        const eq = t.indexOf("=");
        if (eq < 0) continue;
        const key = t.slice(0, eq).trim();
        const val = t.slice(eq + 1).trim();
        if (!(key in process.env)) process.env[key] = val;
      }
      break;
    }
  }
  const REQUIRED_VARS = ["HMAC_SECRET"];
  const missing = REQUIRED_VARS.filter((k) => !process.env[k]);
  if (missing.length) {
    console.error(
      `[agentroom] Missing required env vars: ${missing.join(", ")}
Copy .env.example \u2192 .env and fill in the values.`
    );
    process.exit(1);
  }
  const PORT = parseInt(process.env["PORT"] ?? "8787", 10);
  const httpServer = createServer(handleRequest);
  const wss = attachWss(httpServer);
  httpServer.listen(PORT, () => {
    logEvent("info", "server.start", { port: PORT });
    logEvent("info", "server.config", { log_level: process.env["LOG_LEVEL"] ?? "info" });
  });
  async function gracefulShutdown(signal) {
    logEvent("info", "shutdown.start", { signal });
    httpServer.close();
    const wssInst = getWss() ?? wss;
    const closePromises = Array.from(wssInst.clients).map(
      (ws) => new Promise((resolve) => {
        ws.on("close", resolve);
        ws.close(1001, "server shutting down");
      })
    );
    await Promise.race([
      Promise.all(closePromises),
      new Promise((resolve) => setTimeout(resolve, 5e3))
    ]);
    clearWssIntervals();
    clearChallengeInterval();
    try {
      store.closeDb();
    } catch {
    }
    logEvent("info", "shutdown.done", { signal });
    process.exit(0);
  }
  process.on("SIGINT", () => {
    void gracefulShutdown("SIGINT");
  });
  process.on("SIGTERM", () => {
    void gracefulShutdown("SIGTERM");
  });
  return httpServer;
}
var DB_PATH, db, stmts, store, CHALLENGE_TTL_MS, challenges, BUCKET_IDLE_TTL_MS, challengeCleanupTimer, rateBuckets, counters, LEVELS, agents, wsPkMap, pingIntervals, pruneTimer, _wss, BACKPRESSURE_BYTES, startedAt, TRUST_PROXY;
var init_chunk_IRL77W62 = __esm({
  "packages/server/dist/chunk-IRL77W62.js"() {
    "use strict";
    init_wrapper();
    init_dist();
    DB_PATH = process.env["AGENTROOM_DB"] ?? path6.join(process.cwd(), "data", "agentroom.db");
    if (DB_PATH !== ":memory:") {
      fs.mkdirSync(path6.dirname(DB_PATH), { recursive: true });
    }
    db = new DatabaseSync(DB_PATH);
    db.exec("PRAGMA journal_mode = WAL;");
    db.exec("PRAGMA foreign_keys = ON;");
    db.exec(`
  CREATE TABLE IF NOT EXISTS agents (
    ed25519_pk    TEXT PRIMARY KEY,
    x25519_pk     TEXT NOT NULL,
    registered_at INTEGER NOT NULL DEFAULT (unixepoch()),
    last_seen     INTEGER
  );

  CREATE TABLE IF NOT EXISTS invites (
    invite_id   TEXT PRIMARY KEY,
    blob        TEXT NOT NULL,
    inviter_pk  TEXT NOT NULL,
    expires_at  INTEGER NOT NULL,
    claimed_at  INTEGER
  );

  CREATE TABLE IF NOT EXISTS pending_messages (
    id          TEXT PRIMARY KEY,
    to_pk       TEXT NOT NULL,
    envelope    TEXT NOT NULL,
    created_at  INTEGER NOT NULL DEFAULT (unixepoch())
  );

  CREATE INDEX IF NOT EXISTS idx_pending_to ON pending_messages(to_pk);
  CREATE INDEX IF NOT EXISTS idx_invites_expires ON invites(expires_at);
  CREATE INDEX IF NOT EXISTS idx_invites_inviter ON invites(inviter_pk);
`);
    stmts = {
      upsertAgent: db.prepare(
        `INSERT INTO agents (ed25519_pk, x25519_pk, last_seen)
     VALUES (?, ?, unixepoch())
     ON CONFLICT(ed25519_pk) DO UPDATE SET x25519_pk=excluded.x25519_pk, last_seen=excluded.last_seen`
      ),
      touchAgent: db.prepare(
        `UPDATE agents SET last_seen=unixepoch() WHERE ed25519_pk=?`
      ),
      getAgent: db.prepare(
        `SELECT ed25519_pk, x25519_pk FROM agents WHERE ed25519_pk=?`
      ),
      countAgents: db.prepare(`SELECT COUNT(*) as n FROM agents`),
      publishInvite: db.prepare(
        `INSERT OR IGNORE INTO invites (invite_id, blob, inviter_pk, expires_at)
     VALUES (?, ?, ?, ?)`
      ),
      // expires_at is epoch MILLISECONDS (set by the client from the invite blob),
      // so it must be compared against a JS Date.now() parameter — comparing it to
      // SQLite's unixepoch() (seconds) silently never expires anything.
      claimInvite: db.prepare(
