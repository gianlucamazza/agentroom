  async init(peerPk, bootstrapKeys) {
    const sendEphemeral = await generateKeypair();
    const session = {
      peerPk,
      sendChainKey: bootstrapKeys.sendKey,
      recvChainKey: bootstrapKeys.recvKey,
      sendEphemeral,
      recvEphemeralPk: null,
