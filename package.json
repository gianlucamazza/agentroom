{
  "name": "agentroom",
  "version": "1.15.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @agentroom/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "tsc --noEmit --project tsconfig.base.json",
    "setup": "npm install && npm run build && npm link -w @agentroom/cli",
    "bundle:cli": "bash scripts/bundle-cli.sh",
    "sync-skill": "bash scripts/sync-skill.sh",
    "e2e:live": "bash scripts/e2e-live.sh",
    "e2e:live:tunnel": "bash scripts/e2e-live-tunnel.sh"
  },
  "devDependencies": {
    "@types/node": "^25",
    "tsup": "^8.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
