import { createRequire } from "module";
import { randomUUID } from "crypto";
async function sodiumReady() {
  if (!_ready) {
    await libsodium_cjs_default.ready;
    _ready = true;
  }
  return libsodium_cjs_default;
}
async function generateKeypair() {
  const sodium2 = await sodiumReady();
  const sign2 = sodium2.crypto_sign_keypair();
  const dh = sodium2.crypto_box_keypair();
  return {
    ed25519_pk: sign2.publicKey,
    ed25519_sk: sign2.privateKey,
    x25519_pk: dh.publicKey,
    x25519_sk: dh.privateKey
  };
}
async function sign(message, sk) {
  const sodium2 = await sodiumReady();
  return sodium2.crypto_sign_detached(message, sk);
}
async function verify(message, sig, pk) {
  const sodium2 = await sodiumReady();
  try {
    return sodium2.crypto_sign_verify_detached(sig, message, pk);
  } catch {
    return false;
  }
}
async function dhSharedSecret(our_sk, their_pk) {
  const sodium2 = await sodiumReady();
  return sodium2.crypto_scalarmult(our_sk, their_pk);
}
async function hkdf(ikm, salt, info, len = 32) {
  const sodium2 = await sodiumReady();
  const prk = sodium2.crypto_generichash(32, ikm, salt);
  const infoBytes = new TextEncoder().encode(info);
  const t1Input = new Uint8Array(infoBytes.length + 1);
  t1Input.set(infoBytes);
  t1Input[infoBytes.length] = 1;
  const okm = sodium2.crypto_generichash(len, t1Input, prk);
  return okm;
}
async function seal(plaintext, key) {
  const sodium2 = await sodiumReady();
  const nonce = sodium2.randombytes_buf(sodium2.crypto_secretbox_NONCEBYTES);
  const ciphertext = sodium2.crypto_secretbox_easy(plaintext, nonce, key);
  return { ciphertext, nonce };
}
async function open(ciphertext, nonce, key) {
  const sodium2 = await sodiumReady();
  const plaintext = sodium2.crypto_secretbox_open_easy(ciphertext, nonce, key);
  if (!plaintext) throw new Error("decryption failed: authentication error");
  return plaintext;
}
function toBase64(b) {
  return Buffer.from(b).toString("base64url");
}
function fromBase64(s) {
  return new Uint8Array(Buffer.from(s, "base64url"));
}
async function ratchetStep(rootKey, dhOutput) {
  const newRootKey = await hkdf(dhOutput, rootKey, "agentroom-v2-root", 32);
  const chainKey = await hkdf(dhOutput, rootKey, "agentroom-v2-chain", 32);
  return { newRootKey, chainKey };
}
async function messageKey(chainKey, seq) {
  const sodium2 = await sodiumReady();
  const seqBytes = new Uint8Array(4);
  new DataView(seqBytes.buffer).setUint32(0, seq, false);
  return sodium2.crypto_generichash(32, seqBytes, chainKey);
}
function parseFrame(raw) {
  const result = AnyFrameSchema.safeParse(raw);
  if (result.success) return { ok: true, data: result.data };
  return { ok: false, error: result.error.message };
}
async function createInvite(inviter_ed25519_pk, inviter_ed25519_sk, inviter_x25519_pk, server_url, ttl_ms = 864e5) {
  const sodium2 = await sodiumReady();
  const nonce = toBase64(sodium2.randombytes_buf(16));
  const blob = {
    invite_id: randomUUID(),
    inviter_ed25519_pk: toBase64(inviter_ed25519_pk),
    inviter_x25519_pk: toBase64(inviter_x25519_pk),
    server_url,
    expires_at: Date.now() + ttl_ms,
    nonce
  };
  const blobBytes = new TextEncoder().encode(JSON.stringify(blob));
  const sigBytes = await sign(blobBytes, inviter_ed25519_sk);
  const signed = { blob, sig: toBase64(sigBytes) };
  const encoded = toBase64(new TextEncoder().encode(JSON.stringify(signed)));
  const url2 = `agentroom://invite/${encoded}`;
  return { signed, url: url2 };
}
async function parseInviteUrl(url2) {
  try {
    const prefix = "agentroom://invite/";
    if (!url2.startsWith(prefix)) return { ok: false, error: "not an agentroom invite URL" };
    const encoded = url2.slice(prefix.length);
    const json3 = new TextDecoder().decode(fromBase64(encoded));
    const signed = JSON.parse(json3);
    if (!signed.blob || !signed.sig) return { ok: false, error: "malformed invite" };
    const CLOCK_SKEW_GRACE_MS = 3e4;
    if (Date.now() > signed.blob.expires_at + CLOCK_SKEW_GRACE_MS) return { ok: false, error: "invite expired" };
    const blobBytes = new TextEncoder().encode(JSON.stringify(signed.blob));
    const valid = await verify(
      blobBytes,
      fromBase64(signed.sig),
      fromBase64(signed.blob.inviter_ed25519_pk)
    );
    if (!valid) return { ok: false, error: "invalid signature" };
    return { ok: true, signed };
  } catch (e) {
    return { ok: false, error: String(e) };
  }
}
