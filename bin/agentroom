async function deriveSessionKeys(our_dh_sk, their_dh_pk, nonce, role) {
  const shared = await dhSharedSecret(our_dh_sk, their_dh_pk);
  const saltBytes = fromBase64(nonce);
  const keyA = await hkdf(shared, saltBytes, "agentroom-v1-keyA", 32);
  const keyB = await hkdf(shared, saltBytes, "agentroom-v1-keyB", 32);
  return role === "inviter" ? { sendKey: keyA, recvKey: keyB } : { sendKey: keyB, recvKey: keyA };
}
var b642 = external_exports.string().min(1);
var SerializedRatchetSchema = external_exports.object({
  peerPk: external_exports.string().min(1),
  sendChainKey: b642,
  recvChainKey: b642,
  sendEphemeral: external_exports.object({
    ed25519_pk: b642,
    ed25519_sk: b642,
    x25519_pk: b642,
    x25519_sk: b642
  }),
  recvEphemeralPk: b642,
  sendSeq: external_exports.number().int(),
  recvSeq: external_exports.number().int(),
  needsSendDhStep: external_exports.boolean(),
  skippedMessageKeys: external_exports.array(
    external_exports.tuple([external_exports.string(), external_exports.object({ key: b642, addedAt: external_exports.number().int() })])
  ),
  // Optional: sessions serialized before lastUsedAt existed fall back to now.
  lastUsedAt: external_exports.number().int().optional()
});
function serializeSession(state) {
  const serialized = {
    peerPk: state.peerPk,
    sendChainKey: toBase64(state.sendChainKey),
    recvChainKey: toBase64(state.recvChainKey),
    sendEphemeral: {
      ed25519_pk: toBase64(state.sendEphemeral.ed25519_pk),
      ed25519_sk: toBase64(state.sendEphemeral.ed25519_sk),
      x25519_pk: toBase64(state.sendEphemeral.x25519_pk),
      x25519_sk: toBase64(state.sendEphemeral.x25519_sk)
    },
    recvEphemeralPk: toBase64(state.recvEphemeralPk),
    sendSeq: state.sendSeq,
    recvSeq: state.recvSeq,
    needsSendDhStep: state.needsSendDhStep,
    skippedMessageKeys: [...state.skippedMessageKeys.entries()].map(
      ([k, v]) => [k, { key: toBase64(v.key), addedAt: v.addedAt }]
    ),
    lastUsedAt: state.lastUsedAt
  };
  return JSON.stringify(serialized, null, 2);
}
function deserializeSession(json3) {
  let raw;
  try {
    raw = JSON.parse(json3);
  } catch (e) {
    throw new Error(
      `corrupt session state: invalid JSON (${e instanceof Error ? e.message : String(e)})`
    );
  }
  const parsed = SerializedRatchetSchema.safeParse(raw);
  if (!parsed.success) {
    throw new Error(`corrupt session state: ${parsed.error.message}`);
  }
  const s = parsed.data;
  const skippedMap = new Map(
    s.skippedMessageKeys.map(([k, v]) => [
      k,
      { key: fromBase64(v.key), addedAt: v.addedAt }
    ])
  );
  return {
    peerPk: s.peerPk,
    sendChainKey: fromBase64(s.sendChainKey),
    recvChainKey: fromBase64(s.recvChainKey),
    sendEphemeral: {
      ed25519_pk: fromBase64(s.sendEphemeral.ed25519_pk),
      ed25519_sk: fromBase64(s.sendEphemeral.ed25519_sk),
      x25519_pk: fromBase64(s.sendEphemeral.x25519_pk),
      x25519_sk: fromBase64(s.sendEphemeral.x25519_sk)
    },
    recvEphemeralPk: fromBase64(s.recvEphemeralPk),
    sendSeq: s.sendSeq,
    recvSeq: s.recvSeq,
    needsSendDhStep: s.needsSendDhStep,
    skippedMessageKeys: skippedMap,
    lastUsedAt: s.lastUsedAt ?? Date.now()
  };
}
var MAX_SKIP = 100;
var SKIP_KEY_TTL_MS = 5 * 6e4;
var SessionStore = class {
  map = /* @__PURE__ */ new Map();
  get(peerPk) {
    return this.map.get(peerPk);
  }
  set(peerPk, state) {
    this.map.set(peerPk, state);
  }
  has(peerPk) {
    return this.map.has(peerPk);
  }
  list() {
    return [...this.map.keys()];
  }
  /**
   * Initialize a ratchet session, seeding the DH ratchet so post-compromise security
   * is active from the first message:
   *  - sendEphemeral = our static identity keypair (its x25519 pub is what the peer
   *    knows for us from the invite), recvEphemeralPk = peer's static x25519 pub.
   *    These mutually-known keys define the first DH ratchet pair, so send and recv
   *    derivations stay symmetric without an asymmetric "first contact" branch.
   *  - initiateRatchet=true on exactly ONE side (the inviter) seeds needsSendDhStep,
   *    so the first DH step is one-sided → strict alternation, no concurrent rotation.
   */
  async init(peerPk, bootstrapKeys, seed) {
    const session = {
      peerPk,
      sendChainKey: bootstrapKeys.sendKey,
      recvChainKey: bootstrapKeys.recvKey,
      sendEphemeral: seed.identity,
      recvEphemeralPk: seed.peerX25519Pk,
      sendSeq: 0,
      recvSeq: -1,
      needsSendDhStep: seed.initiateRatchet,
      skippedMessageKeys: /* @__PURE__ */ new Map(),
      lastUsedAt: Date.now()
    };
    this.map.set(peerPk, session);
    return session;
  }
};
async function encryptMessage(session, plaintext) {
  if (session.needsSendDhStep && session.recvEphemeralPk !== null) {
    const newEph = await generateKeypair();
    const dhOut = await dhSharedSecret(
      newEph.x25519_sk,
      session.recvEphemeralPk
    );
    const { chainKey } = await ratchetStep(session.sendChainKey, dhOut);
    session.sendChainKey = chainKey;
    session.sendEphemeral = newEph;
    session.sendSeq = 0;
    session.needsSendDhStep = false;
  }
  const msgKey = await messageKey(session.sendChainKey, session.sendSeq);
  const { ciphertext, nonce } = await seal(plaintext, msgKey);
  const { chainKey: nextChainKey } = await ratchetStep(
    session.sendChainKey,
    msgKey
  );
  session.sendChainKey = nextChainKey;
  session.sendSeq++;
  session.lastUsedAt = Date.now();
  return {
    ciphertext: toBase64(ciphertext),
    nonce: toBase64(nonce),
    ratchet_pk: toBase64(session.sendEphemeral.x25519_pk)
  };
}
async function decryptMessage(session, ciphertext, nonce, seq, ratchet_pk_b64) {
  const skipKey = `${ratchet_pk_b64 ?? ""}:${seq}`;
  const skipped = session.skippedMessageKeys.get(skipKey);
  if (skipped) {
    session.skippedMessageKeys.delete(skipKey);
    return open(fromBase64(ciphertext), fromBase64(nonce), skipped.key);
  }
  const snapshot2 = {
    recvChainKey: session.recvChainKey,
    recvEphemeralPk: session.recvEphemeralPk,
    sendChainKey: session.sendChainKey,
    sendEphemeral: session.sendEphemeral,
    sendSeq: session.sendSeq,
    recvSeq: session.recvSeq,
    needsSendDhStep: session.needsSendDhStep
  };
  try {
    if (ratchet_pk_b64) {
      const prevPkB64 = toBase64(session.recvEphemeralPk);
      if (ratchet_pk_b64 !== prevPkB64) {
        const newPeerPk = fromBase64(ratchet_pk_b64);
        const dhOut = await dhSharedSecret(
          session.sendEphemeral.x25519_sk,
          newPeerPk
        );
        const { chainKey: newRecvChain } = await ratchetStep(
          session.recvChainKey,
          dhOut
        );
        session.recvChainKey = newRecvChain;
        session.recvEphemeralPk = newPeerPk;
        session.recvSeq = -1;
        session.needsSendDhStep = true;
      }
    }
    if (seq <= session.recvSeq) {
      throw new Error(
        `replay detected: seq ${seq} <= last seen ${session.recvSeq}`
      );
    }
    const peerPkForSkip = ratchet_pk_b64 ?? toBase64(session.recvEphemeralPk);
    if (seq > session.recvSeq + 1) {
      await storeSkippedKeys(session, peerPkForSkip, seq);
    }
    const msgKey = await messageKey(session.recvChainKey, seq);
    const plaintext = await open(
      fromBase64(ciphertext),
      fromBase64(nonce),
      msgKey
    );
    const { chainKey: nextChainKey } = await ratchetStep(
      session.recvChainKey,
      msgKey
    );
    session.recvChainKey = nextChainKey;
    session.recvSeq = seq;
    session.lastUsedAt = Date.now();
    return plaintext;
  } catch (e) {
    session.recvChainKey = snapshot2.recvChainKey;
    session.recvEphemeralPk = snapshot2.recvEphemeralPk;
    session.sendChainKey = snapshot2.sendChainKey;
    session.sendEphemeral = snapshot2.sendEphemeral;
    session.sendSeq = snapshot2.sendSeq;
    session.recvSeq = snapshot2.recvSeq;
    session.needsSendDhStep = snapshot2.needsSendDhStep;
    throw e;
  }
}
async function storeSkippedKeys(session, peerPkB64, upToSeq) {
  const startSeq = session.recvSeq + 1;
  if (upToSeq <= startSeq) return;
  const count = Math.min(upToSeq - startSeq, MAX_SKIP);
  if (count === MAX_SKIP && upToSeq - startSeq > MAX_SKIP) {
    console.warn(
      `[agentroom] skipping ${upToSeq - startSeq - MAX_SKIP} out-of-order messages (exceed MAX_SKIP=${MAX_SKIP})`
    );
  }
  const now = Date.now();
  for (const [k, v] of session.skippedMessageKeys) {
    if (now - v.addedAt > SKIP_KEY_TTL_MS) session.skippedMessageKeys.delete(k);
  }
  let chainKey = session.recvChainKey;
  for (let i = 0; i < count; i++) {
    const s = startSeq + i;
    const key = await messageKey(chainKey, s);
    const { chainKey: next } = await ratchetStep(chainKey, key);
    session.skippedMessageKeys.set(`${peerPkB64}:${s}`, { key, addedAt: now });
    chainKey = next;
  }
  session.recvChainKey = chainKey;
  session.recvSeq = startSeq + count - 1;
}
function pruneSkippedInPlace(state, ttlMs = SKIP_KEY_TTL_MS, maxSize = MAX_SKIP) {
  const now = Date.now();
  for (const [k, v] of state.skippedMessageKeys) {
    if (now - v.addedAt > ttlMs) state.skippedMessageKeys.delete(k);
  }
  if (state.skippedMessageKeys.size > maxSize) {
    const sorted = [...state.skippedMessageKeys.entries()].sort(
      (a, b) => a[1].addedAt - b[1].addedAt
    );
    const toRemove = sorted.slice(0, state.skippedMessageKeys.size - maxSize);
    for (const [k] of toRemove) state.skippedMessageKeys.delete(k);
  }
}
async function signFrame(payload, sk) {
  return toBase64(await sign(payload, sk));
}
async function verifyFrameSig(payload, sig, pk) {
  return verify(payload, fromBase64(sig), fromBase64(pk));
}
function configBase(home) {
  return home ?? path.join(process.env["HOME"] ?? "~", ".config", "agentroom");
}
function identityPath(home) {
  return path.join(configBase(home), "identity.json");
}
function sessionsDir(home) {
  return path.join(configBase(home), "sessions");
}
async function loadOrCreateIdentity(home) {
  const idPath = identityPath(home);
  const dir = path.dirname(idPath);
  if (existsSync(idPath)) {
    const raw = JSON.parse(readFileSync(idPath, "utf8"));
    return {
      ed25519_pk: fromBase64(raw.ed25519_pk),
      ed25519_sk: fromBase64(raw.ed25519_sk),
      x25519_pk: fromBase64(raw.x25519_pk),
      x25519_sk: fromBase64(raw.x25519_sk),
      path: idPath
    };
  }
  mkdirSync(dir, { recursive: true });
  const kp = await generateKeypair();
  const stored = {
    ed25519_pk: toBase64(kp.ed25519_pk),
    ed25519_sk: toBase64(kp.ed25519_sk),
    x25519_pk: toBase64(kp.x25519_pk),
    x25519_sk: toBase64(kp.x25519_sk)
  };
  writeFileSync(idPath, JSON.stringify(stored, null, 2), { encoding: "utf8" });
  chmodSync(idPath, 384);
  return { ...kp, path: idPath };
}
function saveSession(peerPk, state, home) {
  const dir = sessionsDir(home);
  mkdirSync(dir, { recursive: true });
  const file2 = path.join(dir, `${peerPk}.json`);
  writeFileSync(file2, serializeSession(state), { encoding: "utf8" });
  chmodSync(file2, 384);
}
function loadAllSessions(home, maxAgeDays = 30) {
  const dir = sessionsDir(home);
  if (!existsSync(dir)) return [];
  const cutoff = Date.now() - maxAgeDays * 864e5;
  const results = [];
  for (const file2 of readdirSync(dir)) {
    if (!file2.endsWith(".json")) continue;
    const filePath = path.join(dir, file2);
    try {
      const state = deserializeSession(readFileSync(filePath, "utf8"));
      if (state.lastUsedAt < cutoff) {
        unlinkSync(filePath);
        continue;
      }
      results.push(state);
    } catch (err) {
      const corrupt = `${filePath}.corrupt-${Date.now()}`;
      try {
        renameSync(filePath, corrupt);
      } catch {
      }
      console.warn(`[agentroom] corrupt session file renamed to ${path.basename(corrupt)}:`, err instanceof Error ? err.message : err);
    }
  }
  return results;
}
var DEFAULT_BACKOFF = [1e3, 2e3, 4e3, 8e3, 16e3, 32e3, 6e4];
var PRUNE_INTERVAL_MS = 5 * 6e4;
var AgentroomClient = class {
  ws = null;
  pk = "";
  identity = null;
  pendingAcks = /* @__PURE__ */ new Map();
  onMessageHandlers = [];
  onPeerOnlineHandlers = [];
  onDisconnectHandlers = [];
  onReconnectHandlers = [];
  onReconnectFailedHandlers = [];
  serverUrl = "";
  home = void 0;
  sessionToken = null;
  reconnectEnabled = false;
  reconnectAttempt = 0;
  reconnectMaxAttempts = Infinity;
  reconnectMaxBackoffMs = 6e4;
  destroyed = false;
  currentReconnectTimer = null;
  pruneTimer = null;
  // per-instance session store — no cross-client contamination
  store = new SessionStore();
  // AbortController to cancel in-flight fetch on disconnect
  connectAbort = null;
  onMessage(fn) {
    this.onMessageHandlers.push(fn);
  }
  onPeerOnline(fn) {
    this.onPeerOnlineHandlers.push(fn);
  }
  onDisconnect(fn) {
    this.onDisconnectHandlers.push(fn);
  }
  onReconnect(fn) {
    this.onReconnectHandlers.push(fn);
  }
  onReconnectFailed(fn) {
    this.onReconnectFailedHandlers.push(fn);
  }
  async connect(opts) {
    await sodiumReady();
    this.serverUrl = opts.serverUrl;
    this.home = opts.home;
    this.reconnectEnabled = opts.autoReconnect ?? false;
    this.reconnectMaxAttempts = opts.reconnect?.maxAttempts ?? Infinity;
    this.reconnectMaxBackoffMs = opts.reconnect?.maxBackoffMs ?? 6e4;
    this.identity = await loadOrCreateIdentity(opts.home);
    this.pk = toBase64(this.identity.ed25519_pk);
    for (const state of loadAllSessions(opts.home)) {
      this.store.set(state.peerPk, state);
    }
    this._pruneAllSkippedKeys();
    await this._doConnect();
    this.reconnectAttempt = 0;
    if (!this.pruneTimer) {
      this.pruneTimer = setInterval(
        () => this._pruneAllSkippedKeys(),
        PRUNE_INTERVAL_MS
      );
      this.pruneTimer.unref?.();
    }
  }
  /** Inner connect — also used for reconnect. */
  async _doConnect() {
    if (!this.identity) throw new Error("identity not loaded");
    if (this.sessionToken) {
      const connected = await this._openWs(this.serverUrl, false, void 0, {
        authorization: `Bearer ${this.sessionToken}`
      });
      if (connected) return;
      this.sessionToken = null;
    }
    const httpBase = this.serverUrl.replace(/^wss?:\/\//, "http://").replace(/\/ws$/, "");
    this.connectAbort = new AbortController();
    let resp;
    try {
      resp = await fetch(`${httpBase}/auth/challenge`, {
        signal: this.connectAbort.signal
      });
    } finally {
      this.connectAbort = null;
    }
    if (!resp.ok) {
      const hint = resp.status === 429 ? " (rate limited \u2014 retry in ~60s)" : "";
      throw new Error(`challenge request failed: ${resp.status}${hint}`);
    }
    const { challenge } = await resp.json();
    await this._openWs(this.serverUrl, true, challenge);
  }
  _openWs(wsUrl, withHello, challenge, headers) {
    return new Promise((resolve, reject) => {
      const ws = new wrapper_default(wsUrl, headers ? { headers } : void 0);
      this.ws = ws;
      let settled = false;
      let established = false;
      const settle = (cb) => {
        if (settled) return;
        settled = true;
        cb();
      };
      ws.once("open", async () => {
        if (!withHello) {
          ws.send(
            JSON.stringify({
              v: PROTOCOL_VERSION,
              type: "PING",
              msg_id: randomUUID2(),
              ts: Date.now()
            })
          );
          return;
        }
        const challengeBytes = new TextEncoder().encode(challenge);
        const sig = await signFrame(challengeBytes, this.identity.ed25519_sk);
        this._sendRaw({
          v: PROTOCOL_VERSION,
          type: "HELLO",
          msg_id: randomUUID2(),
          ts: Date.now(),
          ed25519_pk: this.pk,
          x25519_pk: toBase64(this.identity.x25519_pk),
          sig,
          challenge
        });
      });
      const onFirstMessage = async (raw) => {
        let parsed;
        try {
          parsed = JSON.parse(raw.toString());
        } catch {
          return;
        }
        const result = parseFrame(parsed);
        if (!result.ok) return;
        const frame = result.data;
        if (frame.type === "HELLO_ACK") {
          this.sessionToken = frame.session_token;
          ws.off("message", onFirstMessage);
          ws.on("message", this._handleRawMessage.bind(this));
          established = true;
          settle(() => {
            if (withHello) resolve();
          });
          return;
        }
        if (frame.type === "ERROR" && !withHello) {
          ws.close();
          settle(() => resolve(false));
          return;
        }
        if (!withHello) {
          ws.off("message", onFirstMessage);
          ws.on("message", this._handleRawMessage.bind(this));
          established = true;
          settle(() => resolve(true));
          await this._handleRawMessage(raw);
        }
      };
      ws.on("message", onFirstMessage);
      ws.once("error", (e) => settle(() => reject(e)));
      ws.on("close", (code, reason) => {
        ws.off("message", onFirstMessage);
        this.ws = null;
        const reasonStr = reason?.toString() || `code ${code}`;
        if (!settled) {
          settle(
            () => withHello ? reject(
              new Error(`connection closed during handshake: ${reasonStr}`)
            ) : resolve(false)
          );
          return;
        }
        if (!established) return;
        if (this.reconnectEnabled && !this.destroyed) {
          for (const h of this.onDisconnectHandlers) h(reasonStr);
          void this._scheduleReconnect();
        }
      });
    });
  }
  async _handleRawMessage(raw) {
    let parsed;
    try {
      parsed = JSON.parse(raw.toString());
    } catch {
      return;
    }
    const result = parseFrame(parsed);
    if (!result.ok) return;
    try {
      await this._handleFrame(result.data);
    } catch (err) {
      console.warn(
        "[sdk] error handling frame:",
        err instanceof Error ? err.message : err
      );
    }
  }
  async _scheduleReconnect() {
    if (this.destroyed || !this.reconnectEnabled) return;
    if (this.reconnectAttempt >= this.reconnectMaxAttempts) {
      const reason = `max reconnect attempts (${this.reconnectMaxAttempts}) reached`;
      for (const h of this.onReconnectFailedHandlers) h(reason);
      return;
    }
    const backoffSteps = DEFAULT_BACKOFF.map(
      (ms) => Math.min(ms, this.reconnectMaxBackoffMs)
    );
    const delay = backoffSteps[Math.min(this.reconnectAttempt, backoffSteps.length - 1)] ?? this.reconnectMaxBackoffMs;
    this.reconnectAttempt++;
    await new Promise((resolve) => {
      this.currentReconnectTimer = setTimeout(resolve, delay);
    });
    this.currentReconnectTimer = null;
    if (this.destroyed) return;
    try {
      await this._doConnect();
      this.reconnectAttempt = 0;
      for (const h of this.onReconnectHandlers) h();
    } catch {
      if (!this.destroyed && this.reconnectEnabled)
        void this._scheduleReconnect();
    }
  }
  /** Send a frame. Returns false (and warns) if the socket isn't open, so the
   *  caller can fail fast instead of dropping the frame silently. */
  _sendRaw(data) {
    if (!this.ws || this.ws.readyState !== wrapper_default.OPEN) {
      console.warn("[sdk] socket not open \u2014 outbound frame not sent");
      return false;
    }
    this.ws.send(JSON.stringify(data));
    return true;
  }
  async _handleFrame(frame) {
    switch (frame.type) {
      case "DELIVERY":
        await this._handleDelivery(frame.routed);
        break;
      case "ACK": {
        const cb = this.pendingAcks.get(frame.ref_msg_id);
        if (cb) {
          cb(frame.status, frame.error);
          this.pendingAcks.delete(frame.ref_msg_id);
        }
        break;
      }
      case "PING":
        this._sendRaw({ ...frame, type: "PONG" });
        break;
    }
  }
  async _handleDelivery(routed) {
    const sigPayload = new TextEncoder().encode(
      JSON.stringify({
        from: routed.from,
        to: routed.to,
        seq: routed.seq,
        nonce: routed.nonce
      })
    );
    const valid = await verifyFrameSig(sigPayload, routed.sig, routed.from);
    if (!valid) {
      console.warn("[sdk] invalid frame signature from", routed.from);
      return;
    }
    if (routed.type === "SESSION_INIT") {
      await this._handleSessionInit(routed);
      return;
    }
    if (routed.type === "SESSION_ACK") {
      await this._handleSessionAck(routed);
      return;
    }
    const session = this.store.get(routed.from);
    if (!session) {
      console.warn("[sdk] no session for", routed.from);
      return;
    }
    const plainBytes = await decryptMessage(
      session,
      routed.ciphertext,
      routed.nonce,
      routed.seq,
      routed.ratchet_pk
    );
    saveSession(session.peerPk, session, this.home);
    const text = new TextDecoder().decode(plainBytes);
    for (const h of this.onMessageHandlers) h(routed.from, text);
  }
  async _handleSessionInit(routed) {
    if (!this.identity) return;
    if (this.store.has(routed.from)) {
      console.warn(
        "[sdk] ignoring duplicate SESSION_INIT from",
        routed.from.slice(0, 8)
      );
      return;
    }
    const initPayload = JSON.parse(
      new TextDecoder().decode(fromBase64(routed.ciphertext))
    );
    const bootstrapKeys = await deriveSessionKeys(
      this.identity.x25519_sk,
      fromBase64(initPayload.x25519_pk),
      initPayload.nonce,
      "inviter"
    );
    const session = await this.store.init(routed.from, bootstrapKeys, {
      identity: this.identity,
      peerX25519Pk: fromBase64(initPayload.x25519_pk),
      initiateRatchet: true
    });
    saveSession(session.peerPk, session, this.home);
    const ackPlain = new TextEncoder().encode(
      JSON.stringify({ ack: initPayload.nonce })
    );
    const { ciphertext: ackCiphertext, nonce: ackNonceOut } = await seal(
      ackPlain,
      bootstrapKeys.sendKey
    );
    const sigPayload = new TextEncoder().encode(
      JSON.stringify({
        from: this.pk,
        to: routed.from,
        seq: 0,
        nonce: toBase64(ackNonceOut)
      })
    );
    const sig = await signFrame(sigPayload, this.identity.ed25519_sk);
    this._sendRaw({
      v: PROTOCOL_VERSION,
      type: "SESSION_ACK",
      msg_id: randomUUID2(),
      ts: Date.now(),
      from: this.pk,
      to: routed.from,
      ciphertext: toBase64(ackCiphertext),
      nonce: toBase64(ackNonceOut),
      sig,
      seq: 0
    });
    for (const h of this.onPeerOnlineHandlers) h(routed.from);
  }
  async _handleSessionAck(routed) {
    const session = this.store.get(routed.from);
    if (!session) {
      console.warn("[sdk] SESSION_ACK without prior session for", routed.from);
      return;
    }
    saveSession(session.peerPk, session, this.home);
    for (const h of this.onPeerOnlineHandlers) h(routed.from);
  }
  async createInvite(serverUrl) {
    if (!this.identity) throw new Error("not connected");
    const url2 = serverUrl ?? this.serverUrl;
    const { signed, url: inviteUrl } = await createInvite(
      this.identity.ed25519_pk,
      this.identity.ed25519_sk,
      this.identity.x25519_pk,
      url2
    );
    await this.waitAck((msg_id) => {
      return this._sendRaw({
        v: PROTOCOL_VERSION,
        type: "INVITE_PUBLISH",
        msg_id,
        ts: Date.now(),
        invite_id: signed.blob.invite_id,
        blob: toBase64(new TextEncoder().encode(JSON.stringify(signed))),
        expires_at: signed.blob.expires_at
      });
    });
    return { url: inviteUrl, invite_id: signed.blob.invite_id };
  }
  async acceptInvite(inviteUrl) {
    if (!this.identity) throw new Error("not connected");
    const result = await parseInviteUrl(inviteUrl);
    if (!result.ok) throw new Error(result.error);
    const { blob } = result.signed;
    const bootstrapKeys = await deriveSessionKeys(
      this.identity.x25519_sk,
      fromBase64(blob.inviter_x25519_pk),
      blob.nonce,
      "invitee"
    );
    const session = await this.store.init(
      blob.inviter_ed25519_pk,
      bootstrapKeys,
      {
        identity: this.identity,
        peerX25519Pk: fromBase64(blob.inviter_x25519_pk),
        initiateRatchet: false
      }
    );
    saveSession(session.peerPk, session, this.home);
    const initPayload = JSON.stringify({
      x25519_pk: toBase64(this.identity.x25519_pk),
      nonce: blob.nonce
    });
    const ciphertextB64 = toBase64(new TextEncoder().encode(initPayload));
    const sigPayload = new TextEncoder().encode(
      JSON.stringify({
        from: this.pk,
        to: blob.inviter_ed25519_pk,
        seq: 0,
        nonce: ciphertextB64
      })
    );
    const sig = await signFrame(sigPayload, this.identity.ed25519_sk);
    await this.waitAck((msg_id) => {
      return this._sendRaw({
        v: PROTOCOL_VERSION,
        type: "INVITE_CLAIM",
        msg_id,
        ts: Date.now(),
        invite_id: blob.invite_id,
        from: this.pk,
        ciphertext: ciphertextB64,
        nonce: ciphertextB64,
        sig
      });
    });
    return blob.inviter_ed25519_pk;
  }
  async sendMessage(peerPk, text) {
    if (!this.identity) throw new Error("not connected");
    const session = this.store.get(peerPk);
    if (!session) {
      throw new Error(
        `No session with ${peerPk}.
Run first: agentroom invite create --server <url>
or: agentroom invite accept '<url>' --server <url>`
      );
    }
    const plaintext = new TextEncoder().encode(text);
    const { ciphertext, nonce, ratchet_pk } = await encryptMessage(
      session,
      plaintext
    );
    const seq = session.sendSeq - 1;
    saveSession(session.peerPk, session, this.home);
    const sigPayload = new TextEncoder().encode(
      JSON.stringify({ from: this.pk, to: peerPk, seq, nonce })
    );
    const sig = await signFrame(sigPayload, this.identity.ed25519_sk);
    await this.waitAck((msg_id) => {
      return this._sendRaw({
        v: PROTOCOL_VERSION,
        type: "MSG",
        msg_id,
        ts: Date.now(),
        from: this.pk,
        to: peerPk,
        ciphertext,
        nonce,
        sig,
        seq,
        ratchet_pk
      });
    });
  }
  peers() {
    return this.store.list();
  }
  publicKey() {
    return this.pk;
  }
  disconnect() {
    this.destroyed = true;
    this.reconnectEnabled = false;
    this.connectAbort?.abort();
    this.connectAbort = null;
    if (this.currentReconnectTimer) {
      clearTimeout(this.currentReconnectTimer);
      this.currentReconnectTimer = null;
    }
    if (this.pruneTimer) {
      clearInterval(this.pruneTimer);
      this.pruneTimer = null;
    }
    for (const [msg_id, cb] of this.pendingAcks) {
      cb("error", "client disconnected");
      this.pendingAcks.delete(msg_id);
    }
    for (const peerPk of this.store.list()) {
      const session = this.store.get(peerPk);
      if (session) {
        try {
          saveSession(peerPk, session, this.home);
        } catch {
        }
      }
    }
    this.ws?.close();
  }
  _pruneAllSkippedKeys() {
    for (const peerPk of this.store.list()) {
      const session = this.store.get(peerPk);
      if (session) {
        pruneSkippedInPlace(session);
        try {
          saveSession(peerPk, session, this.home);
        } catch {
        }
      }
    }
  }
  waitAck(send2) {
    const msg_id = randomUUID2();
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => {
        this.pendingAcks.delete(msg_id);
        reject(new Error("ACK timeout"));
      }, 1e4);
      this.pendingAcks.set(msg_id, (status, err) => {
        clearTimeout(timeout);
        if (status === "error") reject(new Error(err ?? "server error"));
        else resolve();
      });
      if (send2(msg_id) === false) {
        clearTimeout(timeout);
        this.pendingAcks.delete(msg_id);
        reject(new Error("socket not open \u2014 message not sent"));
      }
    });
  }
};

// packages/cli/src/commands/init.ts
init_dist();
import { existsSync as existsSync2 } from "fs";
async function cmdInit(args) {
  const homeIdx = args.indexOf("--home");
  const home = homeIdx >= 0 ? args[homeIdx + 1] : void 0;
  const jsonMode = args.includes("--json");
  const idPath = identityPath(home);
  const isNew = !existsSync2(idPath);
  const id = await loadOrCreateIdentity(home);
  const pk = toBase64(id.ed25519_pk);
  const x25519 = toBase64(id.x25519_pk);
  if (jsonMode) {
    console.log(JSON.stringify({ pk, x25519_pk: x25519, identity_path: idPath, created: isNew }));
    return;
  }
  if (isNew) {
    console.log("\u2713 Identity created:", idPath);
  } else {
    console.log("Identity already exists:", idPath);
  }
  console.log("ed25519_pk:", pk);
  console.log("x25519_pk: ", x25519);
  console.log("\nShare your ed25519_pk with peers who want to send you messages.");
}

// packages/cli/src/commands/whoami.ts
import { existsSync as existsSync3, readFileSync as readFileSync2 } from "fs";
async function cmdWhoami(args) {
  const homeIdx = args.indexOf("--home");
  const home = homeIdx >= 0 ? args[homeIdx + 1] : void 0;
  const idPath = identityPath(home);
  if (!existsSync3(idPath)) {
    console.error(JSON.stringify({
      error: "no identity found",
      hint: "run: agentroom init",
      identity_path: idPath
    }));
    process.exit(1);
  }
  const raw = JSON.parse(readFileSync2(idPath, "utf8"));
  console.log(JSON.stringify({
    ed25519_pk: raw.ed25519_pk,
    x25519_pk: raw.x25519_pk,
    identity_path: idPath
  }, null, 2));
}

// packages/cli/src/commands/invite.ts
init_dist();

// packages/cli/src/exitcodes.ts
var EXIT_ERROR = 1;
var EXIT_USAGE = 2;
var EXIT_NETWORK = 3;
var EXIT_NO_SESSION = 4;

// packages/cli/src/commands/invite.ts
function getArg(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
function requireArg(args, flag, name) {
  const v = getArg(args, flag);
  if (!v) {
    console.error(`Missing ${flag} <${name}>`);
    process.exit(EXIT_USAGE);
  }
  return v;
}
function resolveAcceptServer(explicit, blobServerUrl) {
  return explicit ?? blobServerUrl ?? null;
}
async function cmdInviteCreate(args) {
  const server = requireArg(args, "--server", "wss://host/ws");
  const home = getArg(args, "--home");
  const jsonMode = args.includes("--json");
  const client = new AgentroomClient();
  await client.connect({ serverUrl: server, home });
  const { url: url2, invite_id } = await client.createInvite();
  if (jsonMode) {
    console.log(JSON.stringify({ url: url2, invite_id }));
  } else {
    console.log("\nInvite URL (share out-of-band):\n");
    console.log(url2);
    console.log("\nExpires in 24 hours. Single use.");
  }
  client.disconnect();
}
async function cmdInviteAccept(args) {
  const urlArg = args[0];
  if (!urlArg || !urlArg.startsWith("agentroom://")) {
    console.error("Usage: agentroom invite accept '<agentroom://invite/...>' --server <url>");
    process.exit(EXIT_USAGE);
  }
  if (!urlArg.startsWith("agentroom://invite/")) {
    console.error("Invalid invite URL format. Expected: agentroom://invite/<base64url>");
    process.exit(EXIT_USAGE);
  }
  const home = getArg(args, "--home");
  const jsonMode = args.includes("--json");
  let waitSec = parseInt(getArg(args, "--wait") ?? "10", 10);
  if (!Number.isFinite(waitSec) || waitSec <= 0) waitSec = 10;
  const parsed = await parseInviteUrl(urlArg);
  if (!parsed.ok) {
    console.error(parsed.error);
    process.exit(EXIT_USAGE);
  }
  const server = resolveAcceptServer(getArg(args, "--server"), parsed.signed.blob.server_url);
  if (!server) {
    console.error("No relay URL: invite has no server_url and --server <wss://host/ws> was not given");
    process.exit(EXIT_USAGE);
  }
  const client = new AgentroomClient();
  await client.connect({ serverUrl: server, home });
  const peerPk = await client.acceptInvite(urlArg);
  const peerOnline = await new Promise((resolve) => {
    const t = setTimeout(() => resolve(false), waitSec * 1e3);
    t.unref?.();
    client.onPeerOnline((pk) => {
      if (pk === peerPk) {
        clearTimeout(t);
        resolve(true);
      }
    });
  });
  if (jsonMode) {
    console.log(JSON.stringify({ ok: true, peer_pk: peerPk, peer_online: peerOnline }));
  } else if (peerOnline) {
    console.log("\u2713 Session established \u2014 peer online:");
    console.log(peerPk);
  } else {
    console.log("\u2713 Session saved \u2014 peer offline; they'll sync when they next connect:");
    console.log(peerPk);
  }
  client.disconnect();
}

// packages/cli/src/commands/send.ts
function getArg2(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdSend(args) {
  const peerPk = args[0];
  const message = args[1];
  if (!peerPk || !message) {
    console.error("Usage: agentroom send <peer_pk> <message> --server <url>");
    process.exit(EXIT_USAGE);
  }
  if (message.startsWith("--")) {
    console.error(`Usage: agentroom send <peer_pk> "<message>" --server <url>`);
    console.error(`Hint: wrap the message in quotes if it contains spaces or special chars.`);
    process.exit(EXIT_USAGE);
  }
  const server = getArg2(args, "--server");
  if (!server) {
    console.error("--server <wss://host/ws> is required");
    process.exit(EXIT_USAGE);
  }
  const home = getArg2(args, "--home");
  const jsonMode = args.includes("--json");
  const client = new AgentroomClient();
  try {
    await client.connect({ serverUrl: server, home });
  } catch (e) {
    const msg = e instanceof Error ? e.message : String(e);
    if (jsonMode) {
      console.log(JSON.stringify({ ok: false, error: msg }));
    } else {
      console.error("[agentroom] connection failed:", msg);
    }
    process.exit(EXIT_NETWORK);
  }
  try {
    await client.sendMessage(peerPk, message);
    if (jsonMode) {
      console.log(JSON.stringify({ ok: true }));
    } else {
      console.log("\u2713 sent");
    }
  } catch (e) {
    const msg = e instanceof Error ? e.message : String(e);
    if (jsonMode) {
      console.log(JSON.stringify({ ok: false, error: msg }));
    } else if (msg.includes("No session")) {
      console.error(msg);
      console.error("\nTip: sessions are persisted per identity directory.");
      console.error("Make sure you have completed an invite handshake with this peer.");
    } else {
      console.error("[agentroom]", msg);
    }
    const isNoSession = msg.includes("No session");
    const isTimeout = msg.includes("timeout") || msg.includes("ACK timeout");
    process.exitCode = isNoSession ? EXIT_NO_SESSION : isTimeout ? EXIT_NETWORK : 1;
  }
  client.disconnect();
}

// packages/cli/src/commands/listen.ts
function getArg3(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdListen(args) {
  const server = getArg3(args, "--server");
  if (!server) {
    console.error("--server <wss://host/ws> is required");
    process.exit(1);
  }
  const home = getArg3(args, "--home");
  const jsonMode = args.includes("--json");
  const quietMode = args.includes("--quiet");
  const client = new AgentroomClient();
  client.onMessage((from, text) => {
    if (jsonMode) {
      const out = { type: "message", from, ts: Date.now() };
      if (!quietMode) out["text"] = text;
      else out["size"] = new TextEncoder().encode(text).length;
      process.stdout.write(JSON.stringify(out) + "\n");
    } else if (quietMode) {
      console.log(`[${(/* @__PURE__ */ new Date()).toISOString()}] ${from.slice(0, 12)}\u2026 (${new TextEncoder().encode(text).length}B)`);
    } else {
      console.log(`[${(/* @__PURE__ */ new Date()).toISOString()}] ${from.slice(0, 12)}\u2026  ${text}`);
    }
  });
  client.onPeerOnline((pk) => {
    if (jsonMode) {
      process.stdout.write(JSON.stringify({ type: "peer_online", pk, ts: Date.now() }) + "\n");
    } else {
      console.log(`[${(/* @__PURE__ */ new Date()).toISOString()}] peer online: ${pk.slice(0, 12)}\u2026`);
    }
  });
  client.onDisconnect((reason) => {
    if (jsonMode) {
      process.stdout.write(JSON.stringify({ type: "disconnect", reason, ts: Date.now() }) + "\n");
    } else {
      console.error(`[${(/* @__PURE__ */ new Date()).toISOString()}] disconnected (${reason}) \u2014 reconnecting\u2026`);
    }
  });
  client.onReconnect(() => {
    if (jsonMode) {
      process.stdout.write(JSON.stringify({ type: "reconnect", ts: Date.now() }) + "\n");
    } else {
      console.error(`[${(/* @__PURE__ */ new Date()).toISOString()}] reconnected`);
    }
  });
  client.onReconnectFailed((reason) => {
    if (jsonMode) {
      process.stdout.write(JSON.stringify({ type: "reconnect_failed", reason, ts: Date.now() }) + "\n");
    } else {
      console.error(`[${(/* @__PURE__ */ new Date()).toISOString()}] reconnect failed: ${reason}`);
    }
    process.exit(1);
  });
  await client.connect({ serverUrl: server, home, autoReconnect: true });
  if (!jsonMode) console.log("Listening for messages. Ctrl+C to stop.");
  function shutdown() {
    client.disconnect();
    process.exit(0);
  }
  process.on("SIGINT", shutdown);
  process.on("SIGTERM", shutdown);
  await new Promise(() => {
  });
}

// packages/cli/src/handler.ts
import { spawn } from "child_process";
function runHandler(cmd2, text, env, timeoutMs) {
  return new Promise((resolve) => {
    const child = spawn(cmd2, {
      shell: true,
      env: { ...process.env, AGENTROOM_FROM: env.from, AGENTROOM_PK: env.pk }
    });
    let out = "";
    let err = "";
    let settled = false;
    const done = (r) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      clearTimeout(killTimer);
      resolve(r);
    };
    let killTimer;
    const timer = setTimeout(() => {
      err += `
[agentroom] handler timed out after ${Math.round(timeoutMs / 1e3)}s \u2014 killed`;
      child.kill("SIGTERM");
      killTimer = setTimeout(() => child.kill("SIGKILL"), 2e3);
      killTimer.unref?.();
      done({ reply: "", code: -1, stderr: err.trim() });
    }, timeoutMs);
    timer.unref?.();
    child.stdout.on("data", (d) => out += d.toString());
    child.stderr.on("data", (d) => err += d.toString());
    child.on("error", (e) => done({ reply: "", code: -1, stderr: String(e) }));
    child.on(
      "close",
      (code) => done({ reply: (code ?? 0) === 0 ? out.trim() : "", code: code ?? 0, stderr: err })
    );
    child.stdin.on("error", () => {
    });
    child.stdin.write(text);
    child.stdin.end();
  });
}

// packages/cli/src/serve-core.ts
function wireServe(client, opts) {
  const { onMessage, handlerTimeoutMs, once, maxTurns, seed, seedTo, emit, human, exit } = opts;
  let replies = 0;
  let chain = Promise.resolve();
  client.onMessage((from, text) => {
    chain = chain.then(async () => {
      emit({ type: "received", from, text });
      human(`recv ${from.slice(0, 12)}\u2026  ${text}`);
      const { reply, code, stderr } = await runHandler(onMessage, text, { from, pk: client.publicKey() }, handlerTimeoutMs);
      if (code !== 0) {
        emit({ type: "handler_error", from, code, stderr: stderr.slice(0, 500) });
        human(`handler exited ${code} \u2014 no reply sent. ${stderr.slice(0, 200)}`);
        return;
      }
      if (!reply) {
        emit({ type: "no_reply", from });
        human(`handler produced empty reply \u2014 nothing sent`);
        return;
      }
      try {
        await client.sendMessage(from, reply);
        replies++;
        emit({ type: "replied", to: from, text: reply, turn: replies });
        human(`sent ${from.slice(0, 12)}\u2026  ${reply}`);
      } catch (e) {
        emit({ type: "send_error", to: from, error: e instanceof Error ? e.message : String(e) });
        human(`send failed: ${e instanceof Error ? e.message : String(e)}`);
        return;
      }
      if (once || maxTurns > 0 && replies >= maxTurns) {
        emit({ type: "done", replies });
        human(`reached ${once ? "--once" : `--max-turns ${maxTurns}`} \u2014 exiting`);
        exit(0);
      }
    }).catch((e) => {
      emit({ type: "error", error: e instanceof Error ? e.message : String(e) });
    });
  });
  client.onPeerOnline((pk) => emit({ type: "peer_online", pk }));
  client.onDisconnect((reason) => {
    emit({ type: "disconnect", reason });
    human(`disconnected (${reason}) \u2014 reconnecting\u2026`);
  });
  client.onReconnect(() => {
    emit({ type: "reconnect" });
    human("reconnected");
  });
  client.onReconnectFailed((reason) => {
    emit({ type: "reconnect_failed", reason });
    human(`reconnect failed: ${reason}`);
    exit(EXIT_NETWORK);
  });
  async function sendSeed() {
    if (!seed || !seedTo) return;
    try {
      await client.sendMessage(seedTo, seed);
      replies++;
      emit({ type: "replied", to: seedTo, text: seed, turn: replies, seed: true });
      human(`seed ${seedTo.slice(0, 12)}\u2026  ${seed}`);
    } catch (e) {
      emit({ type: "send_error", to: seedTo, error: e instanceof Error ? e.message : String(e) });
      human(`seed send failed: ${e instanceof Error ? e.message : String(e)}`);
      exit(EXIT_NETWORK);
    }
  }
  return { sendSeed };
}

// packages/cli/src/commands/serve.ts
function getArg4(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdServe(args) {
  const server = getArg4(args, "--server");
  if (!server) {
    console.error("--server <wss://host/ws> is required");
    process.exit(EXIT_USAGE);
  }
  const onMessage = getArg4(args, "--on-message");
  if (!onMessage) {
    console.error('--on-message "<command>" is required (message piped to its stdin, stdout is the reply)');
    process.exit(EXIT_USAGE);
  }
  const home = getArg4(args, "--home");
  const jsonMode = args.includes("--json");
  const once = args.includes("--once");
  const maxTurns = Number(getArg4(args, "--max-turns") ?? "0");
  if (!Number.isInteger(maxTurns) || maxTurns < 0) {
    console.error("--max-turns must be a non-negative integer (0 = unlimited)");
    process.exit(EXIT_USAGE);
  }
  const handlerTimeoutSec = Number(getArg4(args, "--handler-timeout") ?? "120");
  if (!Number.isFinite(handlerTimeoutSec) || handlerTimeoutSec < 0) {
    console.error("--handler-timeout must be a non-negative number of seconds (0 = no timeout)");
    process.exit(EXIT_USAGE);
  }
  const handlerTimeoutMs = handlerTimeoutSec === 0 ? 2147483647 : handlerTimeoutSec * 1e3;
  const seed = getArg4(args, "--seed");
  const seedTo = getArg4(args, "--to");
  if (seed && !seedTo) {
    console.error("--seed requires --to <peer_pk>");
    process.exit(EXIT_USAGE);
  }
  const client = new AgentroomClient();
  const emit = (obj) => {
    if (jsonMode) process.stdout.write(JSON.stringify({ ...obj, ts: Date.now() }) + "\n");
  };
  const human = (s) => {
    if (!jsonMode) console.error(`[${(/* @__PURE__ */ new Date()).toISOString()}] ${s}`);
  };
  const exit = (code = 0) => {
    client.disconnect();
    process.exit(code);
  };
  const { sendSeed } = wireServe(client, {
    onMessage,
    handlerTimeoutMs,
    once,
    maxTurns,
    seed,
    seedTo,
    emit,
    human,
    exit
  });
  await client.connect({ serverUrl: server, home, autoReconnect: true });
  emit({ type: "serving", pk: client.publicKey() });
  human("Serving: auto-replying via handler. Ctrl+C to stop.");
  if (args.includes("--invite")) {
    try {
      const { url: url2 } = await client.createInvite();
      emit({ type: "invite", url: url2 });
      human(`invite (share out-of-band):
${url2}`);
    } catch (e) {
      emit({ type: "invite_error", error: e instanceof Error ? e.message : String(e) });
      human(`invite publish failed: ${e instanceof Error ? e.message : String(e)}`);
      exit(EXIT_NETWORK);
    }
  }
  await sendSeed();
  process.on("SIGINT", () => exit(0));
  process.on("SIGTERM", () => exit(0));
  await new Promise(() => {
  });
}

// packages/cli/src/relay-core.ts
import { spawn as spawn2, fork } from "child_process";
import { randomBytes } from "crypto";

// packages/cli/src/cloudflared.ts
import { spawnSync } from "child_process";
import { createHash } from "crypto";
import {
  accessSync,
  chmodSync as chmodSync2,
  constants as fsConstants,
  existsSync as existsSync4,
  mkdirSync as mkdirSync2,
  renameSync as renameSync2,
  rmSync,
  writeFileSync as writeFileSync2
} from "fs";
import path2 from "path";
var CLOUDFLARED_VERSION = "2026.5.2";
var ASSETS = {
  "linux-x64": { asset: "cloudflared-linux-amd64", sha256: "5286698547f03df745adb2355f04c12dde52ef425491e81f433642d695521886" },
  "linux-arm64": { asset: "cloudflared-linux-arm64", sha256: "5a4e8ce2701105271412059f44b6a0bf1ae4542b4d98ff3180c0c019443a5815" },
  "linux-arm": { asset: "cloudflared-linux-arm", sha256: "70a4c869a037bd69af6ce2ad0c4da4a7680d94fcfb8d4c70ecddae24d560762f" },
  "linux-ia32": { asset: "cloudflared-linux-386", sha256: "ad82d1dbed8bbb9d702807cbd97df932cc774d29e9da5c109b7a3c7f7aee2065" },
  "darwin-x64": { asset: "cloudflared-darwin-amd64.tgz", sha256: "7240f709506bc2c1eb9da4d89cf2555499c60280ecb854b7d80e8f17d4b7903d", archive: "tgz" },
  "darwin-arm64": { asset: "cloudflared-darwin-arm64.tgz", sha256: "ba94054c9fd4297645093d59d51442e5e546d07bb0516120e694a13d5b216d38", archive: "tgz" },
  "win32-x64": { asset: "cloudflared-windows-amd64.exe", sha256: "20b9638f685333d623798e733effbad2487093f15ba592f6c7752360ff3b7ab7" },
  "win32-ia32": { asset: "cloudflared-windows-386.exe", sha256: "6736615e8d2b3b61e868e32907e85641b4ec7b2b8c26bd3361ec15e56e53e242" }
};
function isExecutable(p) {
  try {
    accessSync(p, fsConstants.X_OK);
    return true;
  } catch {
    return false;
  }
}
function binaryName() {
  return process.platform === "win32" ? "cloudflared.exe" : "cloudflared";
}
function cachePath(home) {
  return path2.join(configBase(home), "bin", binaryName());
}
function versionOf(bin) {
  const r = spawnSync(bin, ["--version"], { encoding: "utf8" });
  if (r.status !== 0) return void 0;
  const m = `${r.stdout}${r.stderr}`.match(/cloudflared version (\S+)/);
  return m?.[1];
}
function systemCloudflared() {
  const cmd2 = process.platform === "win32" ? "where" : "which";
  const r = spawnSync(cmd2, ["cloudflared"], { encoding: "utf8" });
  if (r.status === 0 && r.stdout.trim()) return r.stdout.trim().split(/\r?\n/)[0];
  return void 0;
}
async function download(spec, binDir, finalPath) {
  mkdirSync2(binDir, { recursive: true });
  const url2 = `https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/${spec.asset}`;
  const res = await fetch(url2, { redirect: "follow" });
  if (!res.ok) throw new Error(`HTTP ${res.status} fetching ${spec.asset}`);
  const buf = Buffer.from(await res.arrayBuffer());
  const digest = createHash("sha256").update(buf).digest("hex");
  if (digest !== spec.sha256) {
    throw new Error(`sha256 mismatch for ${spec.asset}: expected ${spec.sha256}, got ${digest}`);
  }
  const tmp = path2.join(binDir, `.dl.${process.pid}.${spec.asset}`);
  writeFileSync2(tmp, buf);
  const installRaw = () => {
    chmodSync2(tmp, 493);
    if (process.platform === "win32" && existsSync4(finalPath)) rmSync(finalPath, { force: true });
    renameSync2(tmp, finalPath);
  };
  try {
    if (spec.archive === "tgz") {
      const extractDir = path2.join(binDir, `.extract.${process.pid}`);
      mkdirSync2(extractDir, { recursive: true });
      try {
        const r = spawnSync("tar", ["-xzf", tmp, "-C", extractDir], { encoding: "utf8" });
        if (r.status !== 0) throw new Error(`tar extraction failed: ${r.stderr || r.status}`);
        const extracted = path2.join(extractDir, "cloudflared");
        if (!existsSync4(extracted)) throw new Error("cloudflared not found in archive");
        chmodSync2(extracted, 493);
        if (existsSync4(finalPath)) rmSync(finalPath, { force: true });
        renameSync2(extracted, finalPath);
      } finally {
        rmSync(extractDir, { recursive: true, force: true });
      }
    } else {
      installRaw();
    }
  } finally {
    if (existsSync4(tmp)) rmSync(tmp, { force: true });
  }
}
async function ensureCloudflared(opts = {}) {
  const { emit, human, home } = opts;
  const note = (state, extra = {}) => emit?.({ type: "cloudflared", state, ...extra });
  const override = process.env["AGENTROOM_CLOUDFLARED"];
  if (override) {
    if (isExecutable(override)) {
      note("env", { path: override });
      return { path: override, source: "env", version: versionOf(override) };
    }
    throw new Error(`AGENTROOM_CLOUDFLARED=${override} is not an executable file`);
  }
  const key = `${process.platform}-${process.arch}`;
  const spec = ASSETS[key];
  const cached2 = cachePath(home);
  if (spec && existsSync4(cached2) && versionOf(cached2) === CLOUDFLARED_VERSION) {
    note("cached", { path: cached2, version: CLOUDFLARED_VERSION });
    return { path: cached2, source: "cache", version: CLOUDFLARED_VERSION };
  }
  if (spec) {
    try {
      note("downloading", { version: CLOUDFLARED_VERSION, asset: spec.asset });
      human?.(`downloading cloudflared ${CLOUDFLARED_VERSION} (${spec.asset})\u2026`);
      await download(spec, path2.dirname(cached2), cached2);
      note("ready", { path: cached2, version: CLOUDFLARED_VERSION });
      return { path: cached2, source: "downloaded", version: CLOUDFLARED_VERSION };
    } catch (e) {
      const msg = String(e.message ?? e);
      note("download_failed", { error: msg });
      human?.(`cloudflared download failed (${msg}) \u2014 trying system PATH`);
    }
  } else {
    note("unsupported_platform", { platform: key });
  }
  const sys = systemCloudflared();
  if (sys) {
    note("fallback_path", { path: sys });
    return { path: sys, source: "system", version: versionOf(sys) };
  }
  throw new Error(
    spec ? "could not download cloudflared and none found on PATH (offline?) \u2014 install it or set AGENTROOM_CLOUDFLARED" : `no prebuilt cloudflared for ${key} \u2014 install it manually and set AGENTROOM_CLOUDFLARED or put it on PATH`
  );
}
function detectCloudflared(home) {
  const override = process.env["AGENTROOM_CLOUDFLARED"];
  if (override && isExecutable(override)) {
    return { path: override, source: "env", version: versionOf(override) };
  }
  const cached2 = cachePath(home);
  if (existsSync4(cached2)) {
    const v = versionOf(cached2);
    if (v) return { path: cached2, source: "cache", version: v };
  }
  const sys = systemCloudflared();
  if (sys) return { path: sys, source: "system", version: versionOf(sys) };
  return null;
}

// packages/cli/src/relay-core.ts
var sleep = (ms) => new Promise((r) => setTimeout(r, ms));
function flushDns() {
  return new Promise((resolve) => {
    const p = spawn2("resolvectl", ["flush-caches"], { stdio: "ignore" });
    p.on("error", () => resolve());
    p.on("close", () => resolve());
  });
}
async function startRelay(opts) {
  const { port, db: db2, useTunnel, emit, human } = opts;
  let hmac = opts.hmac ?? process.env["HMAC_SECRET"];
  let hmacGenerated = false;
  if (!hmac) {
    hmac = randomBytes(24).toString("hex");
    hmacGenerated = true;
  }
  let cf;
  let srv;
  let shuttingDown = false;
  const shutdown = (code = 0) => {
    if (shuttingDown) return;
    shuttingDown = true;
    opts.onShutdown?.();
    const pending = /* @__PURE__ */ new Set();
    for (const child of [srv, cf]) {
      if (child && child.exitCode === null && !child.killed) {
        pending.add(child);
        child.once("exit", () => {
          pending.delete(child);
          if (pending.size === 0) process.exit(code);
        });
      }
    }
    if (pending.size === 0) {
      process.exit(code);
      return;
    }
    for (const child of pending) child.kill("SIGTERM");
    const force = setTimeout(() => {
      for (const child of pending) child.kill("SIGKILL");
      process.exit(code);
    }, 6e3);
    force.unref?.();
  };
  const env = {
    ...process.env,
    HMAC_SECRET: hmac,
    PORT: String(port)
  };
  if (db2) env["AGENTROOM_DB"] = db2;
  const selfEntry = process.argv[1];
  if (!selfEntry) {
    console.error("cannot determine CLI entry to launch the relay server");
    process.exit(EXIT_ERROR);
  }
  srv = fork(selfEntry, ["__relay-server"], {
    env,
    stdio: ["ignore", "pipe", "pipe", "ipc"]
  });
  srv.stdout?.pipe(process.stderr);
  srv.stderr?.pipe(process.stderr);
  srv.on("exit", (code) => {
    if (!shuttingDown) {
      emit({ type: "server_exit", code });
      human(`server exited (${code}) \u2014 port ${port} in use or misconfigured`);
      shutdown(EXIT_NETWORK);
    }
  });
  const base2 = `http://localhost:${port}`;
  let healthy = false;
  for (let i = 0; i < 50; i++) {
    await sleep(200);
    try {
      const r = await fetch(`${base2}/health`);
      if (r.ok) {
        healthy = true;
        break;
      }
    } catch {
    }
  }
  if (!healthy) {
    human("server did not become healthy in time");
    shutdown(EXIT_NETWORK);
    await sleep(6e4);
  }
  if (hmacGenerated) {
    emit({ type: "hmac_generated", hmac_secret: hmac });
    human(
      `generated ephemeral HMAC_SECRET (pin it in .env to reuse it across restarts): ${hmac}`
    );
  }
  emit({ type: "listening", port, local_url: `ws://localhost:${port}/ws` });
  human(
    `relay listening on ws://localhost:${port}/ws  (health: ${base2}/health)`
  );
  const handle = {
    port,
    base: base2,
    localUrl: `ws://localhost:${port}/ws`,
    hmac,
    hmacGenerated,
    shutdown
  };
  if (useTunnel) {
    human("opening cloudflared quick tunnel (no account/domain needed)\u2026");
    let cfBin;
    try {
      const cfInfo = await ensureCloudflared({ emit, human });
      cfBin = cfInfo.path;
    } catch (e) {
      const msg = `cloudflared unavailable: ${String(e.message ?? e)}`;
      emit({ type: "tunnel_error", error: msg });
      human(msg);
      shutdown(EXIT_ERROR);
      await sleep(6e4);
    }
    cf = spawn2(cfBin, ["tunnel", "--url", base2, "--no-autoupdate"], {
      stdio: ["ignore", "pipe", "pipe"]
    });
    cf.on("error", (e) => {
      const msg = e.code === "ENOENT" ? `cloudflared binary not runnable at ${cfBin}` : String(e);
      emit({ type: "tunnel_error", error: msg });
      human(msg);
      shutdown(EXIT_ERROR);
    });
    let url2 = "";
    let registered = false;
    const onLog = (buf) => {
      const s = buf.toString();
      process.stderr.write(s);
      if (!url2) {
        const m = s.match(/https:\/\/[a-z0-9-]+\.trycloudflare\.com/);
        if (m) url2 = m[0];
      }
      if (/Registered tunnel connection|Connection .* registered/i.test(s))
        registered = true;
    };
    cf.stdout?.on("data", onLog);
    cf.stderr?.on("data", onLog);
    for (let i = 0; i < 120 && (!url2 || !registered); i++) await sleep(500);
    if (!url2) {
      human("cloudflared did not produce a tunnel URL in time");
      shutdown(EXIT_NETWORK);
      await sleep(6e4);
    }
    const wss = url2.replace(/^https:/, "wss:") + "/ws";
    const httpsHost = url2;
    let reachable = false;
    for (let i = 0; i < 50; i++) {
      await flushDns();
      try {
        const r = await fetch(`${httpsHost}/health`);
        if (r.ok) {
          reachable = true;
          break;
        }
      } catch {
      }
      await sleep(500);
    }
    emit({ type: "tunnel", url: wss, https: httpsHost, reachable });
    human(
      reachable ? `public relay ready:  ${wss}` : `tunnel URL (not yet confirmed reachable, give DNS a few s):  ${wss}`
    );
    handle.tunnel = { wss, https: httpsHost, reachable };
  }
  return handle;
}

// packages/cli/src/pidfile.ts
import { mkdirSync as mkdirSync3, writeFileSync as writeFileSync3, readFileSync as readFileSync3, readdirSync as readdirSync2, unlinkSync as unlinkSync2, chmodSync as chmodSync3, existsSync as existsSync5 } from "fs";
import path3 from "path";
function roomsDir(home) {
  return path3.join(configBase(home), "rooms");
}
function pidfilePath(port, home) {
  return path3.join(roomsDir(home), `${port}.json`);
}
function isAlive(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return e.code === "EPERM";
  }
}
function writePidfile(port, meta3, home) {
  const dir = roomsDir(home);
  mkdirSync3(dir, { recursive: true });
  const file2 = pidfilePath(port, home);
  writeFileSync3(file2, JSON.stringify(meta3), { encoding: "utf8" });
  chmodSync3(file2, 384);
}
function removePidfile(port, home) {
  try {
    unlinkSync2(pidfilePath(port, home));
  } catch {
  }
}
function readPidfiles(home, prune = false) {
  const dir = roomsDir(home);
  if (!existsSync5(dir)) return [];
  const out = [];
  for (const file2 of readdirSync2(dir)) {
    if (!file2.endsWith(".json")) continue;
    const port = parseInt(file2.slice(0, -5), 10);
    if (!Number.isInteger(port)) continue;
    let meta3;
    try {
      meta3 = JSON.parse(readFileSync3(path3.join(dir, file2), "utf8"));
    } catch {
      continue;
    }
    const alive = isAlive(meta3.pid);
    if (!alive && prune) {
      removePidfile(port, home);
      continue;
    }
    out.push({ ...meta3, port, alive });
  }
  return out.sort((a, b) => a.port - b.port);
}

// packages/cli/src/commands/relay.ts
function getArg5(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdRelay(args) {
  const port = Number(getArg5(args, "--port") ?? process.env["PORT"] ?? "8787");
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    console.error("--port must be a valid TCP port");
    process.exit(EXIT_USAGE);
  }
  const useTunnel = args.includes("--tunnel");
  const jsonMode = args.includes("--json");
  const db2 = getArg5(args, "--db");
  const hmac = process.env["HMAC_SECRET"] ?? getArg5(args, "--hmac");
  const home = getArg5(args, "--home");
  const emit = (obj) => {
    if (jsonMode) process.stdout.write(JSON.stringify({ ...obj, ts: Date.now() }) + "\n");
  };
  const human = (s) => {
    if (!jsonMode) console.error(`[relay] ${s}`);
  };
  const relay = await startRelay({
    port,
    db: db2,
    hmac,
    useTunnel,
    emit,
    human,
    onShutdown: () => removePidfile(port, home)
  });
  writePidfile(port, {
    pid: process.pid,
    kind: "relay",
    tunnel_url: relay.tunnel?.wss,
    local_url: relay.localUrl,
    started_at: Date.now()
  }, home);
  if (relay.tunnel) human(`share it:  agentroom invite create --server ${relay.tunnel.wss}`);
  process.on("SIGINT", () => relay.shutdown(0));
  process.on("SIGTERM", () => relay.shutdown(0));
  await new Promise(() => {
  });
}

// packages/cli/src/commands/room.ts
function getArg6(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdRoom(args) {
  const sub2 = args[0];
  const rest2 = args.slice(1);
  switch (sub2) {
    case "open":
      return cmdRoomOpen(rest2);
    case "stop":
      return cmdRoomStop(rest2);
    case "status":
      return cmdRoomStatus(rest2);
    default:
      console.error("Usage: agentroom room <open|stop|status>");
      process.exit(EXIT_USAGE);
  }
}
async function cmdRoomOpen(args) {
  const onMessage = getArg6(args, "--on-message");
  if (!onMessage) {
    console.error('--on-message "<command>" is required (message piped to its stdin, stdout is the reply)');
    process.exit(EXIT_USAGE);
  }
  const port = Number(getArg6(args, "--port") ?? process.env["PORT"] ?? "8787");
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    console.error("--port must be a valid TCP port");
    process.exit(EXIT_USAGE);
  }
  const db2 = getArg6(args, "--db");
  const hmac = process.env["HMAC_SECRET"] ?? getArg6(args, "--hmac");
  const home = getArg6(args, "--home");
  const jsonMode = args.includes("--json");
  const useTunnel = !args.includes("--no-tunnel");
  const once = args.includes("--once");
  const maxTurns = Number(getArg6(args, "--max-turns") ?? "0");
  if (!Number.isInteger(maxTurns) || maxTurns < 0) {
    console.error("--max-turns must be a non-negative integer (0 = unlimited)");
    process.exit(EXIT_USAGE);
  }
  const handlerTimeoutSec = Number(getArg6(args, "--handler-timeout") ?? "120");
  if (!Number.isFinite(handlerTimeoutSec) || handlerTimeoutSec < 0) {
    console.error("--handler-timeout must be a non-negative number of seconds (0 = no timeout)");
    process.exit(EXIT_USAGE);
  }
  const handlerTimeoutMs = handlerTimeoutSec === 0 ? 2147483647 : handlerTimeoutSec * 1e3;
  const seed = getArg6(args, "--seed");
  const seedTo = getArg6(args, "--to");
  if (seed && !seedTo) {
    console.error("--seed requires --to <peer_pk>");
    process.exit(EXIT_USAGE);
  }
  const emit = (obj) => {
    if (jsonMode) process.stdout.write(JSON.stringify({ ...obj, ts: Date.now() }) + "\n");
  };
  const human = (s) => {
    if (!jsonMode) console.error(`[room] ${s}`);
  };
  let client;
  const relay = await startRelay({
    port,
    db: db2,
    hmac,
    useTunnel,
    emit,
    human,
    onShutdown: () => {
      client?.disconnect();
      removePidfile(port, home);
    }
  });
  const inviteServerUrl = relay.tunnel?.wss ?? relay.localUrl;
  client = new AgentroomClient();
  const exit = (code = 0) => relay.shutdown(code);
  const { sendSeed } = wireServe(client, {
    onMessage,
    handlerTimeoutMs,
    once,
    maxTurns,
    seed,
    seedTo,
    emit,
    human,
    exit
  });
  await client.connect({ serverUrl: relay.localUrl, home, autoReconnect: true });
  emit({ type: "serving", pk: client.publicKey() });
  human("Serving: auto-replying via handler. Ctrl+C to stop.");
  try {
    const { url: url2 } = await client.createInvite(inviteServerUrl);
    emit({ type: "invite", url: url2 });
    human(`invite (share out-of-band):
${url2}`);
  } catch (e) {
    emit({ type: "invite_error", error: e instanceof Error ? e.message : String(e) });
    human(`invite publish failed: ${e instanceof Error ? e.message : String(e)}`);
    exit(EXIT_NETWORK);
  }
  writePidfile(port, {
    pid: process.pid,
    kind: "room",
    tunnel_url: relay.tunnel?.wss,
    local_url: relay.localUrl,
    started_at: Date.now()
  }, home);
  await sendSeed();
  process.on("SIGINT", () => relay.shutdown(0));
  process.on("SIGTERM", () => relay.shutdown(0));
  await new Promise(() => {
  });
}
function fmtUptime(ms) {
  const s = Math.max(0, Math.floor(ms / 1e3));
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m${s % 60}s`;
  return `${Math.floor(s / 3600)}h${Math.floor(s % 3600 / 60)}m`;
}
async function cmdRoomStatus(args) {
  const home = getArg6(args, "--home");
  const jsonMode = args.includes("--json");
  const rooms = readPidfiles(home, true);
  if (jsonMode) {
    console.log(JSON.stringify({ rooms: rooms.map((r) => ({ ...r, uptime_s: Math.floor((Date.now() - r.started_at) / 1e3) })) }));
    return;
  }
  if (rooms.length === 0) {
    console.log("No rooms running.");
    return;
  }
  for (const r of rooms) {
    console.log(`  port ${r.port}  pid ${r.pid}  ${r.kind.padEnd(5)}  up ${fmtUptime(Date.now() - r.started_at)}`);
    console.log(`    ${r.tunnel_url ?? r.local_url}`);
  }
}
async function cmdRoomStop(args) {
  const home = getArg6(args, "--home");
  const jsonMode = args.includes("--json");
  const all = args.includes("--all");
  const portArg = getArg6(args, "--port");
  const rooms = readPidfiles(home, true).filter((r) => r.alive);
  let targets;
  if (all) {
    targets = rooms;
  } else if (portArg) {
    const port = Number(portArg);
    targets = rooms.filter((r) => r.port === port);
    if (targets.length === 0) {
      console.error(`No running room on port ${port}`);
      process.exit(EXIT_USAGE);
    }
  } else if (rooms.length === 1) {
    targets = rooms;
  } else if (rooms.length === 0) {
    if (jsonMode) console.log(JSON.stringify({ stopped: [] }));
    else console.log("No rooms running.");
    return;
  } else {
    console.error(`${rooms.length} rooms running \u2014 pass --port <n> or --all`);
    process.exit(EXIT_USAGE);
  }
  const stopped = [];
  for (const r of targets) {
    try {
      process.kill(r.pid, "SIGTERM");
    } catch {
    }
    removePidfile(r.port, home);
    stopped.push(r.port);
  }
  if (jsonMode) console.log(JSON.stringify({ stopped }));
  else console.log(`Stopped room(s) on port: ${stopped.join(", ")}`);
}

// packages/cli/src/commands/peers.ts
import { existsSync as existsSync6, readdirSync as readdirSync3, readFileSync as readFileSync4 } from "fs";
import path4 from "path";
function getArg7(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : void 0;
}
async function cmdPeers(args) {
  const home = getArg7(args, "--home");
  const dir = sessionsDir(home);
  if (!existsSync6(dir)) {
    console.log("No sessions found. Complete an invite handshake first.");
    return;
  }
  const files = readdirSync3(dir).filter((f) => f.endsWith(".json"));
  if (files.length === 0) {
    console.log("No sessions found. Complete an invite handshake first.");
    return;
  }
  const jsonMode = args.includes("--json");
  const rows = [];
  for (const file2 of files) {
    try {
      const raw = JSON.parse(readFileSync4(path4.join(dir, file2), "utf8"));
      rows.push({
        pk: raw.peerPk ?? file2.replace(".json", ""),
        lastUsedAt: raw.lastUsedAt ?? 0,
        sendSeq: raw.sendSeq ?? 0,
        recvSeq: raw.recvSeq ?? -1
      });
    } catch {
    }
  }
  rows.sort((a, b) => b.lastUsedAt - a.lastUsedAt);
  if (jsonMode) {
    console.log(JSON.stringify(rows, null, 2));
    return;
  }
  for (const r of rows) {
    const age = r.lastUsedAt ? new Date(r.lastUsedAt).toLocaleString() : "unknown";
    console.log(`${r.pk}`);
    console.log(`  last used: ${age}  sent: ${r.sendSeq}  received: ${r.recvSeq + 1}`);
  }
}

// packages/cli/src/commands/setup.ts
import { randomBytes as randomBytes2 } from "crypto";
import {
  readFileSync as readFileSync5,
  writeFileSync as writeFileSync4,
  mkdirSync as mkdirSync4,
  existsSync as existsSync7,
  unlinkSync as unlinkSync3,
  rmSync as rmSync2,
  chmodSync as chmodSync4
} from "fs";
import path5 from "path";
init_dist();
function healthUrl(serverUrl) {
  return serverUrl.replace(/^ws/, "http").replace(/\/ws$/, "").replace(/\/$/, "") + "/health";
}
async function cmdSetup(args) {
  const jsonMode = args.includes("--json");
  const forceMode = args.includes("--force");
  const noProbe = args.includes("--no-probe");
  const cwdIdx = args.indexOf("--cwd");
  const cwd = cwdIdx >= 0 ? args[cwdIdx + 1] ?? process.cwd() : process.cwd();
  const homeIdx = args.indexOf("--home");
  const home = homeIdx >= 0 ? args[homeIdx + 1] : void 0;
  const nodeMajor = parseInt(process.versions.node.split(".")[0] ?? "0", 10);
  if (nodeMajor < 22) {
    const msg = `Node >= 22 required for node:sqlite (found ${nodeMajor})`;
    if (jsonMode) console.log(JSON.stringify({ ready: false, error: msg }));
    else console.error(`error: ${msg}`);
    process.exit(EXIT_USAGE);
  }
  const steps = [];
  const envFile = path5.resolve(cwd, ".env");
  const envExample = path5.resolve(cwd, ".env.example");
  const inRepo = existsSync7(envFile) || existsSync7(envExample);
  let dataDir;
  if (inRepo) {
    if (!existsSync7(envFile)) {
      const secret2 = randomBytes2(32).toString("hex");
      const content = readFileSync5(envExample, "utf8").replace(
        /^HMAC_SECRET=.*$/m,
        `HMAC_SECRET=${secret2}`
      );
      writeFileSync4(envFile, content, { encoding: "utf8" });
      chmodSync4(envFile, 384);
      steps.push({ step: "env", status: "created" });
    } else {
      steps.push({ step: "env", status: "skipped" });
    }
    dataDir = path5.resolve(cwd, "data");
    mkdirSync4(dataDir, { recursive: true });
    steps.push({ step: "data/", status: "ok" });
  } else {
    steps.push({ step: "env", status: "skipped" });
  }
  const idPath = identityPath(home);
  if (forceMode && existsSync7(idPath)) {
    if (!jsonMode)
      console.warn(`warning: --force: removing existing identity at ${idPath}`);
    unlinkSync3(idPath);
    rmSync2(sessionsDir(home), { recursive: true, force: true });
  }
  const isNew = !existsSync7(idPath);
  const identity = await loadOrCreateIdentity(home);
  const pk = toBase64(identity.ed25519_pk);
  const x25519Pk = toBase64(identity.x25519_pk);
  steps.push({ step: "identity", status: isNew ? "created" : "skipped" });
  const cf = detectCloudflared(home);
  const serverUrlFile = path5.join(configBase(home), "server_url");
  const serverUrl = existsSync7(serverUrlFile) ? readFileSync5(serverUrlFile, "utf8").trim() : "";
  let reachable;
  if (serverUrl && !noProbe) {
    try {
      const r = await fetch(healthUrl(serverUrl), {
        signal: AbortSignal.timeout(3e3)
      });
      reachable = r.ok;
    } catch {
      reachable = false;
    }
  }
  if (jsonMode) {
    console.log(
      JSON.stringify({
        ready: true,
        pk,
        x25519_pk: x25519Pk,
        identity_path: idPath,
        env_path: inRepo ? envFile : void 0,
        data_dir: dataDir,
        cloudflared: cf,
        server_url: serverUrl,
        ...reachable !== void 0 ? { reachable } : {},
        steps
      })
    );
    return;
  }
  for (const s of steps) {
    const icon = s.status === "created" ? "\u2713" : s.status === "ok" ? "\u2713" : "\xB7";
    const label = s.status === "created" ? "created" : s.status === "skipped" ? "exists " : "ok     ";
    console.log(`  ${icon} ${s.step.padEnd(12)} ${label}`);
  }
  console.log();
  console.log(`  ed25519_pk: ${pk}`);
  console.log(`  x25519_pk:  ${x25519Pk}`);
  if (serverUrl) {
    console.log(
      `  server_url: ${serverUrl}${reachable === void 0 ? "" : reachable ? " (reachable)" : " (unreachable)"}`
    );
  }
  console.log();
  console.log("Ready. Next steps:");
  if (serverUrl) {
    console.log("  agentroom invite create  # create an invite for a peer");
  } else {
    console.log(
      "  agentroom room open --on-message '<cmd>'  # relay + tunnel + invite, one command"
    );
  }
}

// packages/cli/src/index.ts
var require3 = createRequire2(import.meta.url);
var { version: version2 } = require3("../package.json");
var [, , cmd, sub, ...rest] = process.argv;
var USAGE = `
agentroom ${version2} \u2014 agent-to-agent encrypted chat

Commands:
  setup [--cwd <dir>] [--home <dir>] [--force] [--json]              First-run bootstrap (--force rotates the identity)
  init [--home <dir>] [--json]                                        Generate or show identity
  whoami [--home <dir>]                                               Print public keys as JSON
  invite create --server <wss://> [--home] [--json]                   Create and publish an invite
  invite accept <url> [--server <wss://>] [--home] [--wait <s>] [--json]  Accept an invite (relay URL taken from the invite if --server omitted)
  send <peer_pk> <msg> --server <wss://> [--home] [--json]            Send a message
  listen --server <wss://> [--home] [--json] [--quiet]                Stream incoming messages
  serve --server <wss://> --on-message "<cmd>" [--home] [--json]      Auto-reply: pipe each message to <cmd>, send its stdout back
        [--invite] [--once] [--max-turns <n>] [--seed "<msg>" --to <pk>]  (--invite publishes+prints an invite on this connection)
  relay [--port <n>] [--tunnel] [--db <path>] [--json]                Run a relay; with --tunnel opens a public cloudflared URL
  room open --on-message "<cmd>" [--no-tunnel] [--port <n>] [--json]  Open a tunneled room in one process: relay + tunnel + invite + auto-reply
        [--home] [--once] [--max-turns <n>] [--seed "<msg>" --to <pk>]  (alias: agentroom host)
  room status [--home] [--json]                                       List running rooms (pid, tunnel URL, uptime)
  room stop [--port <n>] [--all] [--home] [--json]                    Stop a running room by pid (no manual kill)
  peers [--home] [--json]                                             List active sessions
  version                                                             Print version
`.trim();
async function main() {
  if (!cmd || cmd === "help" || cmd === "--help") {
    console.log(USAGE);
    return;
  }
  if (cmd === "version" || cmd === "--version") {
    if (process.argv.includes("--json")) {
      console.log(JSON.stringify({ version: version2 }));
    } else {
      console.log(`agentroom ${version2}`);
    }
    return;
  }
  switch (cmd) {
    // Internal: host the relay server in-process. Used by `agentroom relay`,
    // which forks this same executable so the bundled single-file CLI can run a
    // relay with no separate @agentroom/server module to resolve. Not in USAGE.
    case "__relay-server": {
      const { startServer: startServer2 } = await Promise.resolve().then(() => (init_server(), server_exports));
      await startServer2();
      return;
    }
    case "setup":
      return cmdSetup([sub, ...rest].filter((a) => Boolean(a)));
    case "init":
      return cmdInit([sub, ...rest].filter((a) => Boolean(a)));
    case "whoami":
      return cmdWhoami([sub, ...rest].filter((a) => Boolean(a)));
    case "send":
      return cmdSend([sub, ...rest].filter((a) => Boolean(a)));
    case "listen":
      return cmdListen([sub, ...rest].filter((a) => Boolean(a)));
    case "serve":
      return cmdServe([sub, ...rest].filter((a) => Boolean(a)));
    case "relay":
      return cmdRelay([sub, ...rest].filter((a) => Boolean(a)));
    case "room":
      return cmdRoom([sub, ...rest].filter((a) => Boolean(a)));
    case "host":
      return cmdRoomOpen([sub, ...rest].filter((a) => Boolean(a)));
    // alias for `room open`
    case "peers":
      return cmdPeers([sub, ...rest].filter((a) => Boolean(a)));
    case "invite":
      if (sub === "create") return cmdInviteCreate(rest);
      if (sub === "accept") return cmdInviteAccept(rest);
      console.error("Unknown invite subcommand:", sub);
      process.exit(EXIT_USAGE);
      break;
    default:
      console.error("Unknown command:", cmd);
      console.log(USAGE);
      process.exit(EXIT_USAGE);
  }
}
main().catch((e) => {
  console.error("[agentroom]", e instanceof Error ? e.message : String(e));
  process.exit(1);
});
