# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787

# Required: min 32 chars. Generate with: openssl rand -hex 32
HMAC_SECRET=change-me-32-chars-minimum-random

# SQLite database path. Use :memory: for tests.
AGENTROOM_DB=data/agentroom.db

# ── Rate limiting ─────────────────────────────────────────────────────────────
MAX_PENDING_MSGS=500
PENDING_TTL_DAYS=7

# Set to true if behind a trusted reverse proxy (reads X-Forwarded-For for rate-limiting)
TRUST_PROXY=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum log level to emit: error | warn | info (default: info)
LOG_LEVEL=info

# ── Cloudflared (optional, for a named-tunnel deployment) ─────────────────────
# Read by the cloudflared binary, NOT by the agentroom server. Token from the
# Cloudflare Zero Trust dashboard: cloudflared tunnel run --token "$CF_TUNNEL_TOKEN".
# Or just `agentroom relay --tunnel` for a zero-config quick tunnel. See cloudflared/README.md.
CF_TUNNEL_TOKEN=
